rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isSteward(campId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/campAccess/$(campId))
        && firestore.get(/databases/(default)/documents/campAccess/$(campId)).data.stewardUid == request.auth.uid;
    }

    function isMember(campId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/campAccess/$(campId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/campAccess/$(campId)/members/$(request.auth.uid)).data.memberUid == request.auth.uid;
    }

    function hasCampAccess(campId) {
      return isSteward(campId) || isMember(campId);
    }

    function validImageUpload() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic)');
    }

    function validAudioUpload() {
      return request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/(webm|ogg|mp4|mpeg|wav|aac|x-m4a)(;.*)?');
    }
    match /feed/{campId}/{uid}/{memoryId}/{fileName} {
      allow read: if hasCampAccess(campId);

      allow create, update: if hasCampAccess(campId)
        && uid == request.auth.uid
        && (
          (fileName == "photo.jpg" && validImageUpload())
          || (fileName.matches("[A-Za-z0-9_-]+[.]m4a") && validAudioUpload())
        );

      allow delete: if false;
    }

    match /camps/{campId}/campfeed/{entityId}/{fileName} {
      allow read: if hasCampAccess(campId);
      allow create: if hasCampAccess(campId) && (validImageUpload() || validAudioUpload());
      allow update: if false;
      allow delete: if false;
    }

    match /camps/{campId}/campfire/{entityId}/{fileName} {
      allow read: if hasCampAccess(campId);
      allow create: if hasCampAccess(campId) && (validImageUpload() || validAudioUpload());
      allow update: if false;
      allow delete: if false;
    }

    match /camps/{campId}/profile-photos/{entityId}/{fileName} {
      allow read: if hasCampAccess(campId);
      allow create, update: if isSteward(campId) && validImageUpload();
      allow delete: if false;
    }

    match /camps/{campId}/members/{memberKey}/{fileName} {
      allow read: if hasCampAccess(campId);
      allow create, update: if hasCampAccess(campId) && validImageUpload();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}