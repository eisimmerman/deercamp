<!doctype html>
<html lang="en">

<head>

  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1,viewport-fit=cover">

  <title>
    DeerCamp Create & Share
  </title>

  <link
    rel="stylesheet"
    href="./capture.css">

</head>

<body>

  <main class="capture-shell">

    <header class="capture-header">

      <button
        type="button"
        class="capture-back"
        data-capture-back>
        ← Back
      </button>

      <div class="capture-heading">

        <p class="capture-eyebrow">
          CREATE &amp; SHARE
        </p>

        <h1 data-capture-title>
          Add Your Story
        </h1>

        <p data-capture-intro>
        </p>

      </div>

      <div
        class="capture-camp-name"
        data-capture-camp-name>
      </div>

    </header>


    <form
      class="capture-form"
      data-capture-form>

      <div
        class="capture-fields"
        data-capture-fields>
      </div>


      <section
        class="capture-media"
        data-capture-media>

        <p class="capture-section-label">
          ADD TO THE STORY
        </p>

        <div class="capture-media-actions">

          <button
            type="button"
            data-capture-photo>
            Add Photo
          </button>

          <button
            type="button"
            data-capture-voice>
            Record Voice
          </button>

        </div>

        <p class="capture-media-note">
          Photo and voice capture are demonstrated here.
          Production DeerCamp will connect these controls
          to the field capture services.
        </p>

      </section>


      <section class="capture-preview">

        <p class="capture-section-label">
          WHAT HAPPENS NEXT
        </p>

        <p data-capture-save-note>
          Your contribution will be saved to DeerCamp.
        </p>

      </section>


      <div class="capture-actions">

        <button
          type="button"
          class="capture-cancel"
          data-capture-back>
          Cancel
        </button>

        <button
          type="submit"
          class="capture-save">
          Save &amp; Share
        </button>

      </div>

    </form>


    <section
      class="capture-success"
      data-capture-success
      hidden>

      <p class="capture-eyebrow">
        SAVED
      </p>

      <h2 data-capture-success-title>
        Your story has been added.
      </h2>

      <p data-capture-success-copy>
      </p>

      <button
        type="button"
        class="capture-return"
        data-capture-back>
        Return to Room
      </button>

    </section>

  </main>

  <script
    src="./capture.js?v=20260810-dxb014">
  </script>

</body>
</html>
