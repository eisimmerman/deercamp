* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  min-height: 100%;
  background: #090603;
  color: #efdcba;
}

body {
  font-family:
    Georgia,
    "Times New Roman",
    serif;
}

button,
input,
textarea,
select {
  font: inherit;
}

.capture-shell {
  width:
    min(980px, calc(100% - 34px));
  margin:
    0 auto;
  padding:
    28px 0 52px;
}

.capture-header {
  display:
    grid;
  grid-template-columns:
    auto 1fr auto;
  align-items:
    center;
  gap:
    24px;
  padding:
    12px 0 28px;
  border-bottom:
    1px solid rgba(219,170,91,.30);
}

.capture-eyebrow,
.capture-section-label {
  margin:
    0 0 8px;
  color:
    #dfa950;
  font-family:
    Arial,
    sans-serif;
  font-size:
    .72rem;
  font-weight:
    700;
  letter-spacing:
    .16em;
  text-transform:
    uppercase;
}

.capture-heading h1 {
  margin:
    0;
  color:
    #f5dbaa;
  font-size:
    clamp(2rem,5vw,4rem);
}

.capture-heading p:last-child {
  max-width:
    680px;
  line-height:
    1.5;
}

.capture-camp-name {
  color:
    #d6a75c;
  white-space:
    nowrap;
}

.capture-back,
.capture-media-actions button,
.capture-cancel,
.capture-return,
.capture-save {
  border:
    1px solid rgba(225,182,106,.66);
  border-radius:
    999px;
  padding:
    11px 18px;
  cursor:
    pointer;
}

.capture-back,
.capture-media-actions button,
.capture-cancel,
.capture-return {
  background:
    rgba(47,27,14,.86);
  color:
    #f2d7a7;
}

.capture-save {
  background:
    #6b421c;
  color:
    #fff0d0;
}

.capture-form {
  margin-top:
    30px;
  padding:
    30px;
  border:
    1px solid rgba(215,166,85,.38);
  border-radius:
    22px;
  background:
    rgba(27,16,9,.96);
}

.capture-fields {
  display:
    grid;
  gap:
    20px;
}

.capture-field {
  display:
    grid;
  gap:
    8px;
}

.capture-field label {
  color:
    #e8c88f;
  font-weight:
    700;
}

.capture-field input,
.capture-field textarea,
.capture-field select {
  width:
    100%;
  padding:
    13px 14px;
  border:
    1px solid rgba(211,166,91,.34);
  border-radius:
    12px;
  background:
    rgba(9,6,4,.78);
  color:
    #f2dfbe;
}

.capture-field textarea {
  min-height:
    150px;
  resize:
    vertical;
}

.capture-help {
  margin:
    0;
  color:
    #ae9879;
  font-size:
    .82rem;
}

.capture-media,
.capture-preview {
  margin-top:
    26px;
  padding:
    22px;
  border:
    1px solid rgba(214,166,86,.24);
  border-radius:
    16px;
  background:
    rgba(255,255,255,.02);
}

.capture-media-actions {
  display:
    flex;
  gap:
    12px;
  flex-wrap:
    wrap;
}

.capture-media-note {
  margin-bottom:
    0;
  color:
    #b9a184;
  font-size:
    .82rem;
  line-height:
    1.5;
}

.capture-actions {
  display:
    flex;
  justify-content:
    space-between;
  gap:
    16px;
  margin-top:
    28px;
}

.capture-success {
  margin-top:
    40px;
  padding:
    40px;
  border:
    1px solid rgba(218,170,89,.42);
  border-radius:
    22px;
  text-align:
    center;
  background:
    rgba(35,20,10,.96);
}

.capture-success h2 {
  color:
    #f4d9a7;
  font-size:
    clamp(1.8rem,4vw,3rem);
}

@media (max-width: 760px) {

  .capture-header {
    grid-template-columns:
      1fr;
  }

  .capture-camp-name {
    white-space:
      normal;
  }

  .capture-actions {
    flex-direction:
      column-reverse;
  }
}

/* =========================================================
   DXB-014F — MEDIA DEMO STATES
   ========================================================= */

.capture-media-status {
  display: grid;
  gap: 8px;
  margin-top: 16px;
}

.capture-media-state {
  display: flex;
  align-items: center;
  gap: 9px;

  padding: 10px 12px;

  border:
    1px solid rgba(214,166,86,.24);

  border-radius: 10px;

  background:
    rgba(8,5,3,.48);

  color:
    #d9c09a;

  font-size:
    .84rem;
}

.capture-media-state::before {
  content: "✓";

  color:
    #e4b45f;

  font-weight:
    700;
}

.capture-media-state.is-recording::before {
  content: "●";
}

[data-capture-photo].has-media,
[data-capture-voice].has-media {
  border-color:
    rgba(230,184,100,.88);

  background:
    rgba(76,44,18,.92);
}

[data-capture-voice].is-recording {
  border-color:
    rgba(230,184,100,.88);

  box-shadow:
    0 0 16px rgba(222,166,75,.18);
}

.capture-success {
  animation:
    capture-success-in .24s ease-out;
}

@keyframes capture-success-in {

  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
