<!doctype html>
<html lang="en">

<head>

  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1">

  <title>DeerCamp CampFeed</title>

  <link
    rel="stylesheet"
    href="./feed-proof.css">

</head>

<body>

  <main class="feed-proof">

    <p class="eyebrow">
      CAMPFEED
    </p>

    <h1>
      There it is.
    </h1>

    <p class="intro">
      The post you just created is now part of Camp Rinella.
    </p>

    <section
      class="feed-list"
      data-feed-list>
    </section>

    <button
      type="button"
      data-continue>
      Continue to CampFire
    </button>

  </main>

  <script
    src="./feed-proof.js?v=20260810-dxb014g">
  </script>

<script>
(function () {
  "use strict";

  const params =
    new URLSearchParams(
      window.location.search
    );

  const experience =
    params.get("experience") ||
    "steve-rinella";


  function campfireUrl() {
    return (
      "/v2/experience-builder/runtime/showcase-v2/rooms/campfire/index.html" +
      "?experience=" +
      encodeURIComponent(experience) +
      "&v=20260811-dxb016h"
    );
  }


  function bindContinueToCampFire() {
    const controls =
      Array.from(
        document.querySelectorAll(
          "button, a, [role='button']"
        )
      );


    const control =
      controls.find(
        element =>
          String(
            element.textContent ||
            ""
          )
            .trim()
            .toLowerCase()
            .includes(
              "continue to campfire"
            )
      );


    if (!control) {
      console.warn(
        "DXB-016H Continue to CampFire control not found."
      );

      return;
    }


    control.style.cursor =
      "pointer";


    control.addEventListener(
      "click",
      event => {

        event.preventDefault();
        event.stopPropagation();

        window.location.href =
          campfireUrl();
      }
    );


    console.log(
      "DXB-016H CampFire return ready:",
      campfireUrl()
    );
  }


  if (
    document.readyState ===
    "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      bindContinueToCampFire,
      {
        once: true
      }
    );
  }
  else {
    bindContinueToCampFire();
  }

})();
</script>

</body>
</html>

