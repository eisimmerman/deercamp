:root {
  color-scheme: dark;
  --gold: #f1c878;
  --cream: #fff0c7;
}
* { box-sizing: border-box; }
html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #080604;
  font-family: Georgia, "Times New Roman", serif;
}
body { display: grid; place-items: center; }
button { font: inherit; }
.experience {
  position: relative;
  width: 100vw;
  height: 100dvh;
  overflow: hidden;
  background: #080604;
}
.screen {
  display: none;
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  place-items: center;
}
.screen.active { display: grid; }
.portrait-stage {
  position: relative;
  width: min(100vw, calc(100dvh * 2 / 3));
  height: min(100dvh, calc(100vw * 3 / 2));
  aspect-ratio: 2 / 3;
  overflow: hidden;
  background: #100b07;
}
.landscape-stage {
  position: relative;
  width: min(100vw, calc(100dvh * 4 / 3));
  height: min(100dvh, calc(100vw * 3 / 4));
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: #080604;
}
.full-art {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.hotspot {
  position: absolute;
  z-index: 10;
  appearance: none;
  border: 0;
  padding: 0;
  background: transparent;
  cursor: pointer;
  border-radius: 999px;
  outline: none;
}
.hotspot:focus-visible {
  outline: 3px solid var(--cream);
  outline-offset: 4px;
}
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}
.welcome-cta {
  left: 24.4%;
  top: 58.1%;
  width: 58.4%;
  height: 8.25%;
  border-radius: 16px;
}
.modal-close {
  left: 80.1%;
  top: 16.55%;
  width: 6.1%;
  height: 4.1%;
  border-radius: 50%;
}
.modal-cta {
  left: 21%;
  top: 72.38%;
  width: 63.1%;
  height: 5.35%;
  border-radius: 16px;
}
.glow-target::before,
.glow-target::after {
  content: "";
  position: absolute;
  inset: -1.5%;
  border-radius: inherit;
  pointer-events: none;
}
.glow-target::before {
  border: 2px solid rgba(255,241,199,.96);
  box-shadow:
    0 0 12px rgba(241,200,120,.95),
    0 0 32px rgba(241,200,120,.62),
    inset 0 0 14px rgba(255,235,185,.28);
  animation: campGlow 1.8s ease-in-out infinite;
}
.glow-target::after {
  inset: -4%;
  border: 1px solid rgba(241,200,120,.32);
  box-shadow: 0 0 42px rgba(241,200,120,.4);
  animation: campGlowHalo 1.8s ease-in-out infinite;
}
.glow-target:hover::before,
.glow-target:focus-visible::before {
  border-color: #fff8df;
  box-shadow:
    0 0 18px rgba(255,235,185,1),
    0 0 50px rgba(241,200,120,.88),
    inset 0 0 18px rgba(255,245,215,.4);
}
@keyframes campGlow {
  0%,100% { opacity: .58; transform: scale(.99); }
  50% { opacity: 1; transform: scale(1.018); }
}
@keyframes campGlowHalo {
  0%,100% { opacity: .25; transform: scale(.98); }
  50% { opacity: .72; transform: scale(1.035); }
}
.video-screen {
  background: #000;
}
.video-screen video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: #000;
}
.skip-button {
  position: absolute;
  z-index: 12;
  right: max(1rem, env(safe-area-inset-right));
  bottom: max(1rem, env(safe-area-inset-bottom));
  padding: .7rem 1rem;
  border: 1px solid rgba(246,211,140,.78);
  border-radius: 999px;
  background: rgba(18,12,7,.82);
  color: #f7e7c5;
  cursor: pointer;
}
.video-message {
  position: absolute;
  z-index: 12;
  left: 50%;
  bottom: 5rem;
  transform: translateX(-50%);
  width: min(90%, 580px);
  padding: .8rem 1rem;
  border: 1px solid rgba(246,211,140,.7);
  background: rgba(18,12,7,.9);
  color: #f7e7c5;
  text-align: center;
  font-family: Arial, sans-serif;
}
.tabletop-status {
  position: absolute;
  z-index: 12;
  left: 50%;
  bottom: max(1rem, env(safe-area-inset-bottom));
  transform: translateX(-50%);
  padding: .55rem .9rem;
  border: 1px solid rgba(246,211,140,.45);
  border-radius: 999px;
  background: rgba(18,12,7,.72);
  color: #f7e7c5;
  font-size: .9rem;
  white-space: nowrap;
}
.tabletop-hotspot {
  position: absolute;
  display: block;
  z-index: 8;
  border: 2px solid transparent;
  border-radius: 22px;
  cursor: pointer;
  outline: none;
  transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
}
.tabletop-hotspot::after {
  content: attr(data-tooltip);
  position: absolute;
  left: 50%;
  bottom: -2.5rem;
  transform: translateX(-50%);
  padding: .45rem .75rem;
  border: 1px solid rgba(246,211,140,.7);
  border-radius: 999px;
  background: rgba(18,12,7,.9);
  color: #f7e7c5;
  font: 700 .8rem/1 Arial, sans-serif;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s ease;
}
.tabletop-hotspot:hover,
.tabletop-hotspot:focus-visible {
  border-color: rgba(255,241,199,.95);
  box-shadow: 0 0 18px rgba(241,200,120,.9), 0 0 48px rgba(241,200,120,.45);
  transform: scale(1.015);
}
.tabletop-hotspot:hover::after,
.tabletop-hotspot:focus-visible::after { opacity: 1; }

.tabletop-hotspot.primary-start {
  border-color: rgba(255,241,199,.95);
  box-shadow: 0 0 16px rgba(241,200,120,.85), 0 0 44px rgba(241,200,120,.35);
  animation: tabletopPulse 1.8s ease-in-out infinite;
}

.tabletop-hotspot.primary-start::after {
  opacity: 1;
}

@keyframes tabletopPulse {
  0%,100% {
    transform: scale(1);
    box-shadow: 0 0 12px rgba(241,200,120,.75), 0 0 34px rgba(241,200,120,.28);
  }
  50% {
    transform: scale(1.018);
    box-shadow: 0 0 20px rgba(255,235,185,.95), 0 0 52px rgba(241,200,120,.45);
  }
}

.tabletop-archive { left: 2.8%; top: 1.5%; width: 31.8%; height: 45.5%; }
.tabletop-maps { left: 35.1%; top: 1.7%; width: 24.1%; height: 27.7%; }
.completion-marker {
  display: none;
  position: absolute;
  right: .7rem;
  top: .7rem;
  width: 1.15rem;
  height: 1.15rem;
  border: 2px solid #f2d08d;
  border-radius: 50%;
  background: #6d481c;
  color: transparent;
  box-shadow: 0 2px 8px rgba(0,0,0,.55), inset 0 0 0 2px rgba(255,231,170,.25);
}
.tabletop-hotspot.completed .completion-marker { display: block; }
@media (max-width: 700px) {
  .tabletop-hotspot::after { bottom: .4rem; font-size: .68rem; }
  .completion-marker { width: .9rem; height: .9rem; right: .35rem; top: .35rem; }
  .tabletop-status { font-size: .72rem; }
}
@media (prefers-reduced-motion: reduce) {
  .glow-target::before,
  .glow-target::after { animation: none; opacity: .9; }
}


/* =========================================================
   DXB GENERIC WELCOME OVERLAY
   ========================================================= */

.dxb-opening-copy {
  position: absolute;
  left: 50%;
  bottom: 7%;
  transform: translateX(-50%);
  width: min(78%, 720px);
  padding: 24px 28px 26px;
  text-align: center;
  background: rgba(18, 11, 7, 0.82);
  border: 1px solid rgba(214, 166, 86, 0.72);
  border-radius: 18px;
  box-shadow:
    0 14px 38px rgba(0, 0, 0, 0.48),
    inset 0 0 24px rgba(214, 166, 86, 0.08);
  backdrop-filter: blur(2px);
  z-index: 5;
}

.dxb-opening-eyebrow {
  margin: 0 0 8px;
  font-size: 0.78rem;
  line-height: 1.25;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 700;
  color: #e1b66a;
}

.dxb-opening-title {
  margin: 0 0 12px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2rem, 5vw, 4rem);
  line-height: 0.98;
  color: #f6e2bd;
}

.dxb-opening-body {
  margin: 0 auto 18px;
  max-width: 620px;
  font-size: clamp(0.95rem, 2vw, 1.1rem);
  line-height: 1.55;
  color: #f2dfc1;
}

.dxb-opening-button {
  appearance: none;
  border: 1px solid rgba(225, 182, 106, 0.82);
  border-radius: 999px;
  padding: 12px 22px;
  background: rgba(45, 28, 15, 0.94);
  color: #f6e2bd;
  font-weight: 700;
  cursor: pointer;
}

.dxb-opening-button:hover,
.dxb-opening-button:focus-visible {
  transform: translateY(-1px);
}

@media (max-width: 700px) {
  .dxb-opening-copy {
    bottom: 4%;
    width: calc(100% - 34px);
    padding: 18px 18px 20px;
  }

  .dxb-opening-body {
    font-size: 0.92rem;
  }
}

/* =========================================================
   DXB SHOWCASE V2 — GENERIC SHELL
   ========================================================= */

.dxb-about-link {
  margin-top: 12px;
  border: 0;
  background: transparent;
  color: #e1b66a;
  text-decoration: underline;
  cursor: pointer;
}

.dxb-about-layout {
  width: min(1100px, calc(100% - 36px));
  margin: 36px auto;
  display: grid;
  grid-template-columns: minmax(280px, .9fr) minmax(320px, 1.1fr);
  overflow: hidden;
  border: 1px solid rgba(214,166,86,.48);
  border-radius: 22px;
  background: rgba(20,12,8,.96);
  box-shadow: 0 20px 60px rgba(0,0,0,.5);
}

.dxb-about-media {
  min-height: 580px;
  background: #0d0906;
}

.dxb-about-image {
  width: 100%;
  height: 100%;
  min-height: 580px;
  object-fit: cover;
  display: block;
}

.dxb-about-copy {
  padding: 46px 44px;
  color: #f2dfc1;
}

.dxb-about-eyebrow,
.dxb-section-eyebrow {
  margin: 0 0 10px;
  color: #e1b66a;
  letter-spacing: .16em;
  font-size: .78rem;
  font-weight: 700;
  text-transform: uppercase;
}

.dxb-about-title {
  margin: 0 0 8px;
  font-family: Georgia, "Times New Roman", serif;
  color: #f6e2bd;
  font-size: clamp(2rem,4vw,3.5rem);
}

.dxb-about-subject {
  margin: 0 0 22px;
  color: #e1b66a;
  font-weight: 700;
}

.dxb-about-body {
  line-height: 1.65;
  font-size: 1.05rem;
}

.dxb-about-disclaimer {
  margin-top: 26px;
  padding: 16px 18px;
  border-left: 3px solid rgba(214,166,86,.7);
  background: rgba(255,255,255,.035);
  font-size: .88rem;
  line-height: 1.5;
  color: #d6c3a6;
}

.dxb-about-actions {
  margin-top: 28px;
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.dxb-about-actions button {
  border: 1px solid rgba(225,182,106,.72);
  border-radius: 999px;
  padding: 11px 20px;
  background: rgba(45,28,15,.94);
  color: #f6e2bd;
  cursor: pointer;
}

.dxb-tabletop-identity {
  position: absolute;
  left: 50%;
  top: 48%;
  transform: translate(-50%,-50%);
  min-width: 280px;
  max-width: 48%;
  padding: 14px 22px;
  text-align: center;
  border: 1px solid rgba(214,166,86,.55);
  border-radius: 14px;
  background: rgba(54,32,16,.88);
  box-shadow: 0 10px 28px rgba(0,0,0,.45);
  pointer-events: none;
  z-index: 4;
}

.dxb-tabletop-camp-name {
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.5rem,3.5vw,2.8rem);
  font-weight: 700;
  color: #f1d39e;
}

.dxb-tabletop-subtitle {
  margin-top: 5px;
  color: #dfbc7e;
  font-size: clamp(.72rem,1.3vw,.98rem);
  letter-spacing: .05em;
}

.dxb-room-launcher {
  position: absolute;
  left: 4%;
  right: 4%;
  bottom: 4%;
  display: grid;
  grid-template-columns: repeat(5,minmax(0,1fr));
  gap: 10px;
  z-index: 5;
}

.dxb-room-card {
  position: relative;
  min-height: 108px;
  padding: 14px 13px;
  border: 1px solid rgba(214,166,86,.46);
  border-radius: 14px;
  background: rgba(25,15,9,.9);
  color: #f2dfc1;
  text-decoration: none;
  text-align: left;
}

.dxb-room-card.is-start-room {
  border-color: rgba(237,190,100,.95);
  box-shadow:
    0 0 0 2px rgba(237,190,100,.18),
    0 0 24px rgba(237,190,100,.28);
}

.dxb-room-card.is-unavailable {
  opacity: .48;
}

.dxb-room-order {
  display: block;
  color: #e1b66a;
  font-size: .72rem;
  font-weight: 700;
}

.dxb-room-label {
  display: block;
  margin-top: 5px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.12rem;
  font-weight: 700;
}

.dxb-room-description {
  display: block;
  margin-top: 6px;
  font-size: .78rem;
  line-height: 1.35;
  color: #d8c2a4;
}

.dxb-room-start {
  display: inline-block;
  margin-top: 8px;
  color: #e1b66a;
  font-size: .72rem;
  font-weight: 700;
}

.dxb-journey-shell {
  width: min(1100px,calc(100% - 36px));
  margin: 40px auto;
  padding: 34px;
  border: 1px solid rgba(214,166,86,.48);
  border-radius: 20px;
  background: rgba(20,12,8,.96);
  color: #f2dfc1;
}

[data-dxb-journey-list] {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 16px;
  margin-top: 26px;
}

.dxb-journey-card {
  padding: 20px;
  border: 1px solid rgba(214,166,86,.38);
  border-radius: 14px;
  background: rgba(255,255,255,.03);
}

.dxb-journey-card h2 {
  font-family: Georgia, "Times New Roman", serif;
  color: #f6e2bd;
}

.dxb-journey-card-priority {
  color: #e1b66a;
  font-weight: 700;
}

.dxb-journey-stop-count {
  margin-top: 12px;
  color: #d5ba8b;
  font-size: .82rem;
}

@media (max-width: 800px) {
  .dxb-about-layout {
    grid-template-columns: 1fr;
  }

  .dxb-about-media,
  .dxb-about-image {
    min-height: 320px;
  }

  .dxb-room-launcher {
    position: static;
    grid-template-columns: 1fr 1fr;
    padding: 16px;
  }

  [data-dxb-journey-list] {
    grid-template-columns: 1fr;
  }
}
