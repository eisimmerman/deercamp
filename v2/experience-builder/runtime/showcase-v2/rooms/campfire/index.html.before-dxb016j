<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1,viewport-fit=cover">

  <title>DeerCamp CampFire</title>

  <link
    rel="stylesheet"
    href="./campfire.css">
</head>

<body>

  <main class="campfire-room">

    <header class="campfire-header">

      <button
        class="campfire-return"
        type="button"
        data-dxb-return-to-camp>
        Back to Camp
      </button>

      <div class="campfire-heading">

        <p class="campfire-eyebrow">
          DEERCAMP
        </p>

        <h1 data-campfire-title>
          CampFire
        </h1>

        <p data-campfire-intro></p>

      </div>

      <div
        class="campfire-camp-name"
        data-campfire-camp-name>
      </div>

    </header>


    <section class="campfire-hero">

      <img
        class="campfire-hero-image"
        data-campfire-hero-image
        alt="Featured CampFire story">

      <div
        class="campfire-hero-shade"
        aria-hidden="true">
      </div>

      <div class="campfire-hero-content">

        <p
          class="campfire-kicker"
          data-campfire-hero-kicker>
          STORIES WORTH PASSING DOWN
        </p>

        <h2 data-campfire-hero-title>
          Featured Story
        </h2>

        <p
          class="campfire-hero-copy"
          data-campfire-hero-copy>
        </p>

        <blockquote
          class="campfire-hero-quote"
          data-campfire-hero-quote>
        </blockquote>

        <button
          class="campfire-hero-button"
          type="button"
          data-campfire-hero-button>

          <span aria-hidden="true">▶</span>

          <span data-campfire-hero-button-label>
            Explore Story
          </span>

        </button>

      </div>

    </section>


    <section class="campfire-section">

      <div class="campfire-section-heading">

        <p>VIEW &amp; DISCOVER</p>

        <h2>
          Stories Around the Fire
        </h2>

      </div>

      <div
        class="campfire-featured"
        data-campfire-featured>
      </div>

    </section>


    <section class="campfire-section">

      <div class="campfire-section-heading">

        <p>CAMP CONVERSATIONS</p>

        <h2>
          What would your camp talk about?
        </h2>

      </div>

      <div
        class="campfire-topics"
        data-campfire-topics>
      </div>

    </section>


    <section class="campfire-create">

      <div>

        <p class="campfire-kicker">
          CREATE &amp; SHARE
        </p>

        <h2 data-campfire-create-label>
          Join the Conversation
        </h2>

        <p>
          Add a story, thought or memory while the conversation is still fresh.
        </p>

      </div>

      <button
        class="campfire-create-button"
        type="button">
        Add Your Story
      </button>

    </section>


    <aside
      class="campfire-disclaimer"
      data-campfire-disclaimer>
    </aside>


    <footer>

      <button
        class="campfire-return"
        type="button"
        data-dxb-return-to-camp>
        Return to Camp
      </button>

    </footer>

  </main>

  <script
    src="../../scripts/dxb-room-return.js?v=20260809-dxb012">
  </script>

  <script
    src="./campfire.js?v=20260809-dxb012">
  </script>

<script>
(function () {
  "use strict";

  const params =
    new URLSearchParams(
      window.location.search
    );

  const experience =
    params.get("experience") ||
    "steve-rinella";


  function campUrl() {
    return (
      "/v2/experience-builder/runtime/showcase-v2/index.html" +
      "?experience=" +
      encodeURIComponent(experience) +
      "&v=20260811-dxb016i"
    );
  }


  function bindReturnToCamp() {
    const controls =
      Array.from(
        document.querySelectorAll(
          "button, a, [role='button']"
        )
      );


    const control =
      controls.find(
        element => {

          const text =
            String(
              element.textContent ||
              ""
            )
              .trim()
              .toLowerCase();

          return (
            text === "return to camp" ||
            text === "back to camp"
          );
        }
      );


    if (!control) {

      console.warn(
        "DXB-016I Return to Camp control not found."
      );

      return;
    }


    control.style.cursor =
      "pointer";


    control.addEventListener(
      "click",
      event => {

        event.preventDefault();
        event.stopPropagation();

        window.location.href =
          campUrl();
      }
    );


    console.log(
      "DXB-016I Camp return ready:",
      campUrl()
    );
  }


  if (
    document.readyState ===
    "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      bindReturnToCamp,
      {
        once: true
      }
    );
  }
  else {
    bindReturnToCamp();
  }

})();
</script>

</body>
</html>


