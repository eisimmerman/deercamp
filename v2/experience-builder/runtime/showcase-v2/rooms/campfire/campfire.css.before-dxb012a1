* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  min-height: 100%;
  background: #0b0704;
  color: #f1dfbe;
}

body {
  font-family: Georgia, "Times New Roman", serif;
}

button {
  font: inherit;
}

.campfire-room {
  width: min(1180px, calc(100% - 34px));
  margin: 0 auto;
  padding: 26px 0 50px;
}

.campfire-header {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 24px;
  padding: 20px 0 26px;
  border-bottom: 1px solid rgba(219,170,91,.30);
}

.campfire-return,
.campfire-create-button {
  border: 1px solid rgba(225,182,106,.66);
  border-radius: 999px;
  padding: 11px 18px;
  background: rgba(49,28,14,.88);
  color: #f5dba8;
  cursor: pointer;
}

.campfire-eyebrow,
.campfire-kicker,
.campfire-section-heading p {
  margin: 0 0 7px;
  font-family: Arial, sans-serif;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .17em;
  color: #dda958;
  text-transform: uppercase;
}

.campfire-header h1 {
  margin: 0;
  font-size: clamp(2rem,5vw,4rem);
}

.campfire-camp-name {
  color: #dbae63;
}

.campfire-hero {
  margin: 32px 0;
  padding: 50px 30px;
  border: 1px solid rgba(218,157,70,.38);
  border-radius: 24px;
  text-align: center;
  background:
    radial-gradient(
      circle at 50% 70%,
      rgba(138,63,14,.38),
      rgba(38,18,8,.96) 44%,
      rgba(15,9,5,.98) 76%
    );
}

.campfire-flame {
  margin-bottom: 12px;
  font-size: clamp(3rem,8vw,6rem);
}

.campfire-hero h2 {
  max-width: 760px;
  margin: 0 auto;
  font-size: clamp(1.8rem,4vw,3.35rem);
  line-height: 1.05;
}

.campfire-hero p:last-child {
  max-width: 700px;
  margin: 18px auto 0;
  line-height: 1.55;
}

.campfire-section {
  margin: 34px 0;
}

.campfire-section-heading h2 {
  margin: 0 0 18px;
}

.campfire-featured {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 16px;
}

.campfire-card {
  overflow: hidden;
  border: 1px solid rgba(214,166,86,.37);
  border-radius: 18px;
  background: rgba(34,19,10,.94);
}

.campfire-card img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}

.campfire-card-copy {
  padding: 18px;
}

.campfire-card h3 {
  margin: 0;
  color: #f4d9a8;
}

.campfire-card p {
  line-height: 1.45;
  color: #d9c29f;
}

.campfire-prompt {
  padding-top: 13px;
  border-top: 1px solid rgba(216,166,87,.18);
  color: #e1b76f !important;
  font-style: italic;
}

.campfire-topics {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 12px;
}

.campfire-topic {
  padding: 17px 18px;
  border: 1px solid rgba(214,166,86,.30);
  border-radius: 14px;
  background: rgba(29,17,9,.87);
  color: #ecd09e;
}

.campfire-create {
  margin: 38px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 28px 30px;
  border: 1px solid rgba(211,155,72,.46);
  border-radius: 18px;
  background:
    linear-gradient(
      135deg,
      rgba(52,28,12,.95),
      rgba(23,13,7,.97)
    );
}

.campfire-disclaimer {
  margin: 28px 0;
  padding: 16px 19px;
  border-left: 3px solid rgba(218,166,82,.56);
  background: rgba(255,255,255,.025);
  color: #c5af90;
  font-size: .82rem;
  line-height: 1.5;
}

footer {
  text-align: center;
}

@media (max-width: 800px) {
  .campfire-header {
    grid-template-columns: 1fr;
  }

  .campfire-featured,
  .campfire-topics {
    grid-template-columns: 1fr;
  }

  .campfire-create {
    align-items: flex-start;
    flex-direction: column;
  }
}
