<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1,viewport-fit=cover">

  <title>DeerCamp CampFire</title>

  <link
    rel="stylesheet"
    href="./campfire.css">
</head>

<body>

  <main class="campfire-room">

    <header class="campfire-header">

      <button
        class="campfire-return"
        type="button"
        data-dxb-return-to-camp>
        Back to Camp
      </button>

      <div class="campfire-heading">

        <p class="campfire-eyebrow">
          DEERCAMP
        </p>

        <h1 data-campfire-title>
          CampFire
        </h1>

        <p data-campfire-intro></p>

      </div>

      <div
        class="campfire-camp-name"
        data-campfire-camp-name>
      </div>

    </header>


    <section class="campfire-hero">

      <div
        class="campfire-flame"
        aria-hidden="true">
        🔥
      </div>

      <p class="campfire-kicker">
        STORIES WORTH PASSING DOWN
      </p>

      <h2 data-campfire-hero-title>
        Around every campfire, stories become traditions.
      </h2>

      <p data-campfire-hero-copy></p>

    </section>


    <section class="campfire-section">

      <div class="campfire-section-heading">

        <p>VIEW &amp; DISCOVER</p>

        <h2>
          Stories Around the Fire
        </h2>

      </div>

      <div
        class="campfire-featured"
        data-campfire-featured>
      </div>

    </section>


    <section class="campfire-section">

      <div class="campfire-section-heading">

        <p>CAMP CONVERSATIONS</p>

        <h2>
          What would your camp talk about?
        </h2>

      </div>

      <div
        class="campfire-topics"
        data-campfire-topics>
      </div>

    </section>


    <section class="campfire-create">

      <div>

        <p class="campfire-kicker">
          CREATE &amp; SHARE
        </p>

        <h2 data-campfire-create-label>
          Join the Conversation
        </h2>

        <p>
          Add a story, thought or memory while the conversation is still fresh.
        </p>

      </div>

      <button
        class="campfire-create-button"
        type="button">
        Add Your Story
      </button>

    </section>


    <aside
      class="campfire-disclaimer"
      data-campfire-disclaimer>
    </aside>


    <footer>

      <button
        class="campfire-return"
        type="button"
        data-dxb-return-to-camp>
        Return to Camp
      </button>

    </footer>

  </main>

  <script
    src="../../scripts/dxb-room-return.js?v=20260809-dxb012">
  </script>

  <script
    src="./campfire.js?v=20260809-dxb012">
  </script>

</body>
</html>
