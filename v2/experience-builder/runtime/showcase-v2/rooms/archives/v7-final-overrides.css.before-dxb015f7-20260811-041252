/* ================================================================
   Camp Boddington Artifact Memory guided Create flow
   ================================================================ */

.artifact-memory-intro{
  margin:0 0 18px;
  color:#d7c39b;
  font-size:15px;
  line-height:1.5;
}

.artifact-memory-choice-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
}

.artifact-memory-choice{
  display:grid;
  grid-template-rows:220px auto auto auto;
  gap:6px;
  overflow:hidden;
  padding:0 0 14px;
  border:1px solid #81591f;
  border-radius:12px;
  background:#151007;
  color:#efd39a;
  text-align:left;
  cursor:pointer;
}

.artifact-memory-choice:hover,
.artifact-memory-choice:focus-visible{
  border-color:#e1aa50;
  box-shadow:
    0 0 0 2px rgba(224,166,68,.26),
    0 0 26px rgba(219,147,36,.34);
}

.artifact-memory-choice img{
  display:block;
  width:100%;
  height:220px;
  object-fit:contain;
  background:#080604;
}

.artifact-memory-choice span,
.artifact-memory-choice strong,
.artifact-memory-choice small{
  margin-inline:14px;
}

.artifact-memory-choice span{
  color:#dca74c;
  font-size:10px;
  font-weight:800;
  letter-spacing:.15em;
}

.artifact-memory-choice strong{
  font:700 22px/1.15 Georgia,serif;
}

.artifact-memory-choice small{
  color:#baa77f;
}

.artifact-recorder,
.artifact-memory-review{
  display:grid;
  grid-template-columns:minmax(260px,.9fr) minmax(320px,1.1fr);
  gap:28px;
  align-items:start;
}

.artifact-recorder-object,
.artifact-memory-review-image{
  overflow:hidden;
  border:1px solid #76501e;
  border-radius:12px;
  background:#080604;
}

.artifact-recorder-object img,
.artifact-memory-review-image img{
  display:block;
  width:100%;
  height:360px;
  object-fit:contain;
}

.artifact-recorder-object span,
.artifact-recorder-object strong{
  display:block;
  margin-inline:14px;
}

.artifact-recorder-object span{
  margin-top:12px;
  color:#d8a34a;
  font-size:10px;
  font-weight:800;
  letter-spacing:.14em;
}

.artifact-recorder-object strong{
  margin-top:4px;
  margin-bottom:14px;
  color:#f0d49e;
  font:700 22px/1.2 Georgia,serif;
}

.artifact-recorder-prompt{
  margin:0 0 8px;
  color:#f0d49e;
  font:700 28px/1.15 Georgia,serif;
}

.artifact-recorder-helper{
  margin:0 0 22px;
  color:#c5b28b;
  line-height:1.5;
}

.artifact-recorder-status{
  display:grid;
  grid-template-columns:18px 1fr auto;
  gap:10px;
  align-items:center;
  padding:18px;
  border:1px solid #76501e;
  border-radius:12px;
  background:#171006;
}

.artifact-recording-dot{
  width:13px;
  height:13px;
  border-radius:50%;
  background:#8d744a;
}

.artifact-recorder-status.is-recording
.artifact-recording-dot{
  background:#d94b3f;
  box-shadow:0 0 14px rgba(217,75,63,.8);
  animation:artifact-recording-pulse 1s ease-in-out infinite;
}

.artifact-recorder-status.is-complete
.artifact-recording-dot{
  background:#d8a34a;
}

@keyframes artifact-recording-pulse{
  0%,100%{opacity:.45}
  50%{opacity:1}
}

.artifact-recorder-controls{
  display:flex;
  gap:12px;
  margin-top:16px;
}

.artifact-recorder-review-action{
  margin-top:18px;
}

.artifact-memory-kicker{
  margin:0 0 5px;
  color:#dba64a;
  font-size:10px;
  font-weight:800;
  letter-spacing:.15em;
}

.artifact-memory-review-copy h3{
  margin:0;
  color:#f0d49e;
  font:700 31px/1.12 Georgia,serif;
}

.artifact-memory-byline{
  margin:7px 0 20px;
  color:#bba77e;
}

.artifact-memory-audio-preview{
  padding:15px;
  border:1px solid #76501e;
  border-radius:10px;
  background:#171006;
}

.artifact-memory-audio-preview>div:first-child{
  display:flex;
  justify-content:space-between;
  gap:12px;
  color:#e7cb92;
}

.artifact-waveform{
  display:flex;
  align-items:center;
  gap:5px;
  height:42px;
  margin-top:8px;
}

.artifact-waveform i{
  display:block;
  width:5px;
  border-radius:5px;
  background:#d6a248;
}

.artifact-waveform i:nth-child(3n+1){height:14px}
.artifact-waveform i:nth-child(3n+2){height:30px}
.artifact-waveform i:nth-child(3n){height:21px}

.artifact-memory-transcript-preview{
  margin-top:16px;
  padding:15px;
  border-left:3px solid #b77c27;
  background:rgba(78,50,15,.25);
  color:#ddcfb2;
  line-height:1.5;
}

.artifact-memory-transcript-preview p{
  margin:7px 0 0;
}

.artifact-memory-success{
  max-width:620px;
  margin:auto;
  text-align:center;
  color:#d9c49c;
}

.artifact-memory-success h3{
  margin:5px 0 12px;
  color:#f0d49e;
  font:700 31px/1.1 Georgia,serif;
}


