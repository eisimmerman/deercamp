{
  "room": "campfire",

  "captures": [
    {
      "id": "add-story",

      "title": "Join the Conversation",

      "intro": "Add a story, lesson or memory your camp would want to keep talking about.",

      "fields": [
        {
          "id": "title",
          "label": "Story Title",
          "type": "text",
          "placeholder": "Give this story a short title",
          "required": true
        },

        {
          "id": "topic",
          "label": "Conversation Topic",
          "type": "select",
          "required": true,

          "options": [
            "Stories Worth Passing Down",
            "Wild Game Meals",
            "Hunting Ethics",
            "Public Lands & Conservation",
            "Mentors & Lessons Learned",
            "Camp Traditions"
          ]
        },

        {
          "id": "story",
          "label": "Your Story",
          "type": "textarea",
          "placeholder": "What happened? Who was there? Why do you remember it?",
          "required": true,
          "help": "Write it here, or use Record Voice to tell the story."
        }
      ],

      "saveNote": "This showcase demonstrates how a camp member could add a conversation or story directly from CampFire.",

      "successTitle": "Story Added to CampFire",

      "successCopy": "Your story would now appear in the CampFire feed and become part of the camp's shared history."
    }
  ]
}
