<script>
/* DC_GUIDED_CREATE_STAND_V2 */
(function(){
  const SAVED_KEY = "dc.maps.createStand.saved";
  const REVIEWED_KEY = "dc.maps.createStand.reviewed";

  function hasMojibake(text){
    return /Ãƒ|Ã‚|Ã¢|Ã¯Â¿Â½/.test(text || "");
  }

  function modalContent(){
    return document.querySelector("[data-modal-content]") || document.querySelector(".modal-content");
  }

  function modalCloseButton(){
    return document.querySelector("[data-modal-close]") || document.querySelector(".modal-close");
  }

  function setGuideNote(root, text){
    if(!root) return;
    let note = root.querySelector("[data-dc-guide-note]");
    if(!note){
      note = document.createElement("div");
      note.className = "dc-guide-note";
      note.setAttribute("data-dc-guide-note","1");

      const heading = root.querySelector("h1,h2");
      if(heading){
        heading.insertAdjacentElement("afterend", note);
      } else {
        root.prepend(note);
      }
    }
    note.textContent = text;
  }

  function clearGuideGlow(root){
    (root || document).querySelectorAll(".dc-guide-glow, .dc-guide-glow-soft").forEach(el=>{
      el.classList.remove("dc-guide-glow","dc-guide-glow-soft");
    });
  }

  function addGlow(el, soft){
    if(!el) return;
    el.classList.add(soft ? "dc-guide-glow-soft" : "dc-guide-glow");
  }

  function isFilled(el){
    if(!el) return true;
    if(el.tagName === "SELECT"){
      return !!String(el.value || "").trim();
    }
    if(el.tagName === "TEXTAREA" || el.tagName === "INPUT"){
      return !!String(el.value || "").trim();
    }
    return true;
  }

  function findTypeSelect(root){
    return [...root.querySelectorAll("select")].find(sel =>
      [...sel.options].some(opt => /Elevated Box Blind/i.test(opt.textContent))
    );
  }

  function findSaveStandButton(root){
    return [...root.querySelectorAll("button")].find(btn =>
      /save stand|save/i.test(btn.textContent)
    );
  }

  function findStar(root){
    return root.querySelector(".create-stand-x, [data-create-stand-marker], [data-create-stand-star]");
  }

  function fixBrokenMarkerText(root){
    [...root.querySelectorAll("*")].forEach(el=>{
      if(hasMojibake(el.textContent) && /create-stand|marker|star|label/i.test((el.className || "") + " " + (el.getAttribute("data-role") || ""))){
        el.classList.add("dc-guide-hidden-mojibake");
      }
    });
  }

  function enhanceCreateStandMap(root){
    if(!root) return;

    fixBrokenMarkerText(root);

    const text = root.textContent || "";
    const closeBtn = modalCloseButton();
    const star = findStar(root);

    const saved = sessionStorage.getItem(SAVED_KEY) === "1";
    const reviewed = sessionStorage.getItem(REVIEWED_KEY) === "1";

    clearGuideGlow(root);
    if(closeBtn) closeBtn.classList.remove("dc-guide-glow","dc-guide-glow-soft");

    if(!saved){
      setGuideNote(root, "Tap star to place stand and add details.");
      if(star){
        addGlow(star, false);
        star.setAttribute("title", "Tap star to place stand and add details");
        star.setAttribute("aria-label", "Tap star to place stand and add details");
      }
      return;
    }

    if(saved && !reviewed){
      setGuideNote(root, "Hover over the star locator to review your stand summary.");
      if(star){
        addGlow(star, false);
        star.setAttribute("title", "Hover over the star locator to review your stand summary");
        star.setAttribute("aria-label", "Hover over the star locator to review your stand summary");
      }

      const reviewNow = () => {
        sessionStorage.setItem(REVIEWED_KEY, "1");
        if(star){
          star.classList.remove("dc-guide-glow","dc-guide-glow-soft");
        }
        if(closeBtn){
          addGlow(closeBtn, false);
        }
        setGuideNote(root, "Tap X to close & return to Maps Room.");
      };

      if(star && !star.dataset.dcReviewBound){
        star.dataset.dcReviewBound = "1";
        star.addEventListener("mouseenter", reviewNow);
        star.addEventListener("click", reviewNow);
        star.addEventListener("focus", reviewNow);
      }
      return;
    }

    if(saved && reviewed){
      setGuideNote(root, "Tap X to close & return to Maps Room.");
      if(closeBtn){
        addGlow(closeBtn, false);
      }
    }
  }

  function enhanceStandBuilder(root){
    if(!root) return;

    const typeSelect = findTypeSelect(root);
    const saveBtn = findSaveStandButton(root);
    const allFields = [...root.querySelectorAll("input, select, textarea")]
      .filter(el => !el.disabled && el.type !== "hidden");

    if(!typeSelect || !saveBtn) return;

    const remainingFields = allFields.filter(el => el !== typeSelect);

    function wrapperFor(el){
      return el.closest(".form-row, .field, .input-group, .stack, .builder-field, div") || el;
    }

    function refreshGuide(){
      clearGuideGlow(root);
      saveBtn.classList.remove("dc-guide-glow","dc-guide-glow-soft");

      const typeDone = isFilled(typeSelect);

      if(!typeDone){
        addGlow(wrapperFor(typeSelect), false);
        setGuideNote(root, "Start with Type, then complete the rest of the stand details.");
        return;
      }

      const incomplete = remainingFields.filter(el => {
        if(el.type === "hidden") return false;
        if(el.hasAttribute("readonly")) return false;
        return !isFilled(el);
      });

      if(incomplete.length){
        incomplete.forEach(el => addGlow(wrapperFor(el), true));
        setGuideNote(root, "Make a few choices and complete the remaining fields.");
        return;
      }

      addGlow(saveBtn, false);
      setGuideNote(root, "Everything is ready. Tap Save Stand.");
    }

    if(!root.dataset.dcBuilderBound){
      root.dataset.dcBuilderBound = "1";

      typeSelect.addEventListener("change", refreshGuide);
      remainingFields.forEach(el => {
        el.addEventListener("input", refreshGuide);
        el.addEventListener("change", refreshGuide);
      });

      saveBtn.addEventListener("click", function(){
        sessionStorage.setItem(SAVED_KEY, "1");
        sessionStorage.setItem(REVIEWED_KEY, "0");
      }, true);
    }

    setGuideNote(root, "Start with Type, then complete the rest of the stand details.");
    addGlow(wrapperFor(typeSelect), false);
    refreshGuide();
  }

  function applyGuidance(){
    const root = modalContent();
    if(!root) return;

    const text = root.textContent || "";

    if(/Add Stand Details/i.test(text)){
      enhanceStandBuilder(root);
      return;
    }

    if(/South Texas Hill Country/i.test(text) && /Create Stand Map|Place the stand|Hover over/i.test(text)){
      enhanceCreateStandMap(root);
      return;
    }
  }

  const observer = new MutationObserver(() => {
    setTimeout(applyGuidance, 0);
  });

  observer.observe(document.body, { childList:true, subtree:true });

  document.addEventListener("click", () => {
    setTimeout(applyGuidance, 0);
  }, true);

  window.addEventListener("load", () => {
    setTimeout(applyGuidance, 100);
  });
})();
</script>
