*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:#050403;font-family:Arial,sans-serif}
.maps-room{min-height:100vh;display:grid;place-items:start center}
.room-stage{position:relative;width:min(100vw,1024px);line-height:0}
.room-art{display:block;width:100%;height:auto}
.room-hotspot{position:absolute;border:0;background:transparent;cursor:pointer;border-radius:12px}
.room-hotspot::after{content:attr(data-tooltip);position:absolute;left:50%;bottom:calc(100% + 8px);transform:translateX(-50%);padding:8px 12px;border:1px solid #c68c34;border-radius:8px;background:#181008;color:#f0d394;white-space:nowrap;opacity:0;pointer-events:none;transition:.18s;line-height:1.2;font-weight:700}
.room-hotspot:hover::after,.room-hotspot:focus-visible::after{opacity:1}
.room-hotspot:hover,.room-hotspot:focus-visible{outline:3px solid rgba(242,190,84,.95);box-shadow:0 0 28px 10px rgba(221,143,29,.65)}
.hs-stand-maps{left:35.8%;top:36.4%;width:12.6%;height:13%}
.modal-layer{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:24px}
.modal-layer[hidden]{display:none}
.modal-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(5px)}
.modal-shell{position:relative;width:min(920px,94vw);max-height:90vh;overflow:auto;border:1px solid #b77b27;border-radius:18px;background:#f3ecdf;box-shadow:0 28px 90px #000}
.modal-close{position:absolute;right:14px;top:12px;z-index:2;width:40px;height:40px;border:0;border-radius:50%;background:#e5ded2;color:#111;font-size:28px;cursor:pointer}
.modal-content{padding:28px;color:#2f1d0d}
.eyebrow{margin:0 0 6px;color:#76511e;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
h2,h3{font-family:Georgia,serif;color:#35200d} h2{margin:0 0 18px;font-size:34px} h3{margin:0 0 8px;font-size:26px}
.stand-list-card{display:grid;grid-template-columns:170px 1fr;gap:18px;padding:18px;border:1px solid #d8cdbb;border-radius:16px;background:#fffdfa}
.stand-thumb,.detail-image{display:grid;place-items:center;border:1px solid #ddd3c5;border-radius:12px;background:#f4efe6;overflow:hidden}
.stand-thumb{min-height:170px}.stand-thumb img{width:100%;height:100%;max-height:180px;object-fit:contain}
.meta{margin:0 0 10px;color:#6e4a24;font-weight:700}.description{margin:0 0 12px;color:#5f4630;line-height:1.45}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}.tag{padding:6px 9px;border-radius:999px;background:#eee9e1;color:#6d4b28;font-size:13px;font-weight:700}
.waypoint{display:grid;gap:6px;margin:0 0 16px;padding:13px;border:1px solid #dfd5c7;border-radius:12px;background:#faf7f1}
.waypoint span{color:#6a5139;font-family:ui-monospace,Consolas,monospace}
.actions{display:flex;flex-wrap:wrap;gap:10px}.action{display:inline-flex;align-items:center;justify-content:center;padding:11px 16px;border:1px solid #b57a28;border-radius:999px;background:#fff;color:#4a2d12;text-decoration:none;font-weight:800;cursor:pointer}.action.primary{background:#5a3514;color:#fff0ce}
.detail-grid{display:grid;grid-template-columns:minmax(300px,1fr) minmax(300px,.95fr);gap:24px}
.detail-image{min-height:390px}.detail-image img{width:100%;height:100%;max-height:440px;object-fit:contain}
.detail-fields{display:grid;gap:10px}.field{padding:13px;border:1px solid #ded4c7;border-radius:12px;background:#fffdfa}.field strong{display:block;margin-bottom:4px}
.nav-card{padding:16px;border:1px solid #caa46b;border-radius:14px;background:#fff8e9}.nav-card p{line-height:1.45}
@media(max-width:720px){.modal-content{padding:22px 16px}.stand-list-card,.detail-grid{grid-template-columns:1fr}.stand-thumb{min-height:220px}}
