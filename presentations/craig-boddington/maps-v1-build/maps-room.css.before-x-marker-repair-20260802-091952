*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:#050403;font-family:Arial,sans-serif}
.maps-room{min-height:100vh;display:grid;place-items:start center}
.room-stage{position:relative;width:min(100vw,1024px);line-height:0}
.room-art{display:block;width:100%;height:auto}
.room-hotspot{position:absolute;border:0;background:transparent;cursor:pointer;border-radius:12px}
.room-hotspot::after{content:attr(data-tooltip);position:absolute;left:50%;bottom:calc(100% + 8px);transform:translateX(-50%);padding:8px 12px;border:1px solid #c68c34;border-radius:8px;background:#181008;color:#f0d394;white-space:nowrap;opacity:0;pointer-events:none;transition:.18s;line-height:1.2;font-weight:700}
.room-hotspot:hover::after,.room-hotspot:focus-visible::after{opacity:1}
.room-hotspot:hover,.room-hotspot:focus-visible{outline:3px solid rgba(242,190,84,.95);box-shadow:0 0 28px 10px rgba(221,143,29,.65)}
.hs-stand-maps{left:35.8%;top:36.4%;width:12.6%;height:13%}
.modal-layer{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:24px}
.modal-layer[hidden]{display:none}
.modal-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(5px)}
.modal-shell{position:relative;width:min(920px,94vw);max-height:90vh;overflow:auto;border:1px solid #b77b27;border-radius:18px;background:#f3ecdf;box-shadow:0 28px 90px #000}
.modal-close{position:absolute;right:14px;top:12px;z-index:2;width:40px;height:40px;border:0;border-radius:50%;background:#e5ded2;color:#111;font-size:28px;cursor:pointer}
.modal-content{padding:28px;color:#2f1d0d}
.eyebrow{margin:0 0 6px;color:#76511e;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
h2,h3{font-family:Georgia,serif;color:#35200d} h2{margin:0 0 18px;font-size:34px} h3{margin:0 0 8px;font-size:26px}
.stand-list-card{display:grid;grid-template-columns:170px 1fr;gap:18px;padding:18px;border:1px solid #d8cdbb;border-radius:16px;background:#fffdfa}
.stand-thumb,.detail-image{display:grid;place-items:center;border:1px solid #ddd3c5;border-radius:12px;background:#f4efe6;overflow:hidden}
.stand-thumb{min-height:170px}.stand-thumb img{width:100%;height:100%;max-height:180px;object-fit:contain}
.meta{margin:0 0 10px;color:#6e4a24;font-weight:700}.description{margin:0 0 12px;color:#5f4630;line-height:1.45}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}.tag{padding:6px 9px;border-radius:999px;background:#eee9e1;color:#6d4b28;font-size:13px;font-weight:700}
.waypoint{display:grid;gap:6px;margin:0 0 16px;padding:13px;border:1px solid #dfd5c7;border-radius:12px;background:#faf7f1}
.waypoint span{color:#6a5139;font-family:ui-monospace,Consolas,monospace}
.actions{display:flex;flex-wrap:wrap;gap:10px}.action{display:inline-flex;align-items:center;justify-content:center;padding:11px 16px;border:1px solid #b57a28;border-radius:999px;background:#fff;color:#4a2d12;text-decoration:none;font-weight:800;cursor:pointer}.action.primary{background:#5a3514;color:#fff0ce}
.detail-grid{display:grid;grid-template-columns:minmax(300px,1fr) minmax(300px,.95fr);gap:24px}
.detail-image{min-height:390px}.detail-image img{width:100%;height:100%;max-height:440px;object-fit:contain}
.detail-fields{display:grid;gap:10px}.field{padding:13px;border:1px solid #ded4c7;border-radius:12px;background:#fffdfa}.field strong{display:block;margin-bottom:4px}
.nav-card{padding:16px;border:1px solid #caa46b;border-radius:14px;background:#fff8e9}.nav-card p{line-height:1.45}
@media(max-width:720px){.modal-content{padding:22px 16px}.stand-list-card,.detail-grid{grid-template-columns:1fr}.stand-thumb{min-height:220px}}

/* Lower View & Discover — Stand Maps row. */
.hs-view-stand-maps{
  left:3.7%;
  top:66.7%;
  width:44.8%;
  height:5.7%;
}

/* Both representations of Stand Maps guide the same experience. */
.maps-room .hs-stand-maps,
.maps-room .hs-view-stand-maps{
  outline:3px solid rgba(255,214,121,.98);
  outline-offset:-3px;
  box-shadow:
    inset 0 0 22px rgba(255,218,130,.26),
    0 0 0 2px rgba(177,105,20,.78),
    0 0 30px 10px rgba(226,148,31,.72);
  animation:maps-entry-guidance 1.5s ease-in-out infinite;
}

.maps-room .hs-stand-maps::after,
.maps-room .hs-view-stand-maps::after{
  opacity:1;
}

.maps-room .hs-stand-maps:hover,
.maps-room .hs-stand-maps:focus-visible,
.maps-room .hs-view-stand-maps:hover,
.maps-room .hs-view-stand-maps:focus-visible{
  outline:3px solid rgba(255,226,153,1);
  box-shadow:
    inset 0 0 26px rgba(255,225,147,.34),
    0 0 0 3px rgba(192,122,27,.88),
    0 0 36px 13px rgba(236,165,45,.84);
}

/* Final alignment: lower hotspot belongs on the Stand Maps row,
   not the Property Maps row above it. */
.maps-room .hs-view-stand-maps{
  left:3.7% !important;
  top:71.0% !important;
  width:44.8% !important;
  height:5.2% !important;
}

.drive-map-legend{
  margin:10px 0 0;
  padding:8px 10px;
  border:1px solid #d8c7a2;
  border-radius:12px;
  background:#f5efe3;
  color:#5a3b1a;
  font-size:14px;
  line-height:1.35;
}
.drive-map-legend strong{
  display:block;
  margin-bottom:4px;
  font-size:12px;
  letter-spacing:.06em;
  text-transform:uppercase;
}
.drive-map-legend .dot{
  display:inline-block;
  width:10px;
  height:10px;
  border-radius:50%;
  margin:0 6px 0 0;
  vertical-align:middle;
}
.drive-map-legend .blue{background:#2f73d9}
.drive-map-legend .yellow{background:#f2c94c}

/* ================================================================
   Drive Maps — upper Current Maps drawer
   ================================================================ */

.maps-room .hs-drive-maps{
  left:48.5%;
  top:36.4%;
  width:12.8%;
  height:13.0%;
}

/* ================================================================
   Drive Maps — lower View & Discover row
   ================================================================ */

.maps-room .hs-view-drive-maps{
  left:3.7%;
  top:76.1%;
  width:44.8%;
  height:5.2%;
}

/* Both visible Drive Maps representations guide the same activity. */
.maps-room .hs-drive-maps,
.maps-room .hs-view-drive-maps{
  outline:3px solid rgba(255,214,121,.98);
  outline-offset:-3px;
  box-shadow:
    inset 0 0 22px rgba(255,218,130,.26),
    0 0 0 2px rgba(177,105,20,.78),
    0 0 30px 10px rgba(226,148,31,.72);
  animation:maps-entry-guidance 1.5s ease-in-out infinite;
}

/* Keep each tooltip visible as part of the guided entry state. */
.maps-room .hs-drive-maps::after,
.maps-room .hs-view-drive-maps::after{
  opacity:1;
}

/* Stronger state while hovering or using keyboard focus. */
.maps-room .hs-drive-maps:hover,
.maps-room .hs-drive-maps:focus-visible,
.maps-room .hs-view-drive-maps:hover,
.maps-room .hs-view-drive-maps:focus-visible{
  outline:3px solid rgba(255,226,153,1);
  box-shadow:
    inset 0 0 26px rgba(255,225,147,.34),
    0 0 0 3px rgba(192,122,27,.88),
    0 0 36px 13px rgba(236,165,45,.84);
}

/* ================================================================
   Triangle Deer Drive detail experience
   ================================================================ */

.drive-detail-grid{
  display:grid;
  grid-template-columns:minmax(360px,1.08fr) minmax(330px,.92fr);
  gap:22px;
  align-items:start;
}

.drive-map-panel{
  display:grid;
  gap:12px;
}

.drive-map-image-button{
  display:block;
  width:100%;
  padding:0;
  overflow:hidden;
  border:1px solid #c4a06b;
  border-radius:14px;
  background:#192311;
  cursor:pointer;
}

.drive-map-image-button img{
  display:block;
  width:100%;
  max-height:430px;
  object-fit:contain;
  background:#192311;
}

.drive-map-image-button:hover,
.drive-map-image-button:focus-visible{
  outline:3px solid rgba(188,121,31,.72);
  outline-offset:2px;
}

.drive-map-helper{
  margin:0;
  color:#776149;
  font-size:13px;
}

.drive-map-legend{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:8px 18px;
  padding:12px 14px;
  border:1px solid #d4c3a4;
  border-radius:12px;
  background:#fbf6ec;
  color:#53371c;
  font-size:13px;
}

.drive-map-legend strong{
  width:100%;
  color:#6a451d;
  font-size:11px;
  letter-spacing:.1em;
  text-transform:uppercase;
}

.drive-legend-item{
  display:inline-flex;
  align-items:center;
  gap:7px;
}

.drive-legend-dot{
  display:inline-block;
  width:13px;
  height:13px;
  border:2px solid #fff;
  border-radius:50%;
  box-shadow:0 0 0 1px rgba(0,0,0,.25);
}

.drive-legend-dot.blue{
  background:#2f73d9;
}

.drive-legend-dot.yellow{
  background:#f2c94c;
}

.drive-wind-panel{
  display:flex;
  justify-content:space-between;
  gap:16px;
  padding:13px 15px;
  border:1px dashed #b9a17a;
  border-radius:12px;
  background:#fffdfa;
}

.drive-wind-panel strong{
  color:#3e2b17;
}

.drive-wind-panel span{
  color:#73522f;
  font-weight:700;
}

.drive-detail-copy h3{
  margin-bottom:6px;
}

.drive-intro{
  padding:12px 14px;
  border-left:3px solid #a56c22;
  background:#fbf6ec;
}

.drive-route-list{
  display:grid;
  gap:10px;
}

.drive-route-list .field span{
  display:block;
  line-height:1.45;
}

.drive-actions{
  margin-top:14px;
}

.drive-map-enlarged{
  display:grid;
  gap:16px;
}

.drive-map-enlarged > img{
  display:block;
  width:100%;
  max-height:68vh;
  object-fit:contain;
  border:1px solid #c4a06b;
  border-radius:14px;
  background:#192311;
}

@media(max-width:820px){
  .drive-detail-grid{
    grid-template-columns:1fr;
  }

  .drive-map-image-button img{
    max-height:360px;
  }
}

/* ================================================================
   FINAL MAPS ROOM GUIDANCE OVERRIDE
   Stand Maps first. Drive Maps second.
   ================================================================ */

/* Neutral state for all four View hotspots. */
.maps-room .hs-stand-maps,
.maps-room .hs-view-stand-maps,
.maps-room .hs-drive-maps,
.maps-room .hs-view-drive-maps{
  outline:none !important;
  outline-offset:0 !important;
  box-shadow:none !important;
  animation:none !important;
  filter:none !important;
}

/* Do not leave tooltips permanently visible. */
.maps-room .hs-stand-maps::after,
.maps-room .hs-view-stand-maps::after,
.maps-room .hs-drive-maps::after,
.maps-room .hs-view-drive-maps::after{
  opacity:0 !important;
}

/* Normal tooltip behavior. */
.maps-room .room-hotspot:hover::after,
.maps-room .room-hotspot:focus-visible::after{
  opacity:1 !important;
}

/* Entry step: only both Stand Maps representations glow. */
.maps-room.maps-guide-stand .hs-stand-maps,
.maps-room.maps-guide-stand .hs-view-stand-maps,

/* Second step: only both Drive Maps representations glow. */
.maps-room.maps-guide-drive .hs-drive-maps,
.maps-room.maps-guide-drive .hs-view-drive-maps{
  display:block !important;
  visibility:visible !important;
  opacity:1 !important;
  pointer-events:auto !important;

  outline:3px solid rgba(255,214,121,.98) !important;
  outline-offset:-3px !important;

  box-shadow:
    inset 0 0 22px rgba(255,218,130,.26),
    0 0 0 2px rgba(177,105,20,.78),
    0 0 30px 10px rgba(226,148,31,.72) !important;

  animation:maps-final-guidance-pulse 1.5s ease-in-out infinite !important;
}

/* Keep the active pair's label visible. */
.maps-room.maps-guide-stand .hs-stand-maps::after,
.maps-room.maps-guide-stand .hs-view-stand-maps::after,
.maps-room.maps-guide-drive .hs-drive-maps::after,
.maps-room.maps-guide-drive .hs-view-drive-maps::after{
  opacity:1 !important;
}

@keyframes maps-final-guidance-pulse{
  0%,100%{
    filter:brightness(1);
  }

  50%{
    filter:brightness(1.18);
  }
}

/* ================================================================
   Drive role legend
   ================================================================ */

.drive-role-legend{
  display:flex !important;
  flex-wrap:wrap;
  align-items:center;
  gap:9px 20px;

  margin:10px 0 14px;
  padding:12px 14px;

  border:1px solid #d2bd98;
  border-radius:12px;

  background:#fff8ea;
  color:#4f3418;

  font-size:14px;
  line-height:1.35;
}

.drive-role-legend > strong{
  width:100%;
  color:#6f481b;
  font-size:11px;
  letter-spacing:.11em;
  text-transform:uppercase;
}

.drive-role-item{
  display:inline-flex;
  align-items:center;
  gap:8px;
  font-weight:700;
}

.drive-role-dot{
  display:inline-block;
  width:15px;
  height:15px;
  flex:0 0 15px;

  border:2px solid #fff;
  border-radius:50%;

  box-shadow:0 0 0 1px rgba(0,0,0,.34);
}

.drive-role-dot.blue{
  background:#2f73d9;
}

.drive-role-dot.yellow{
  background:#f2c94c;
}

/* ================================================================
   Create Stand Map — final guided Maps Room activity
   ================================================================ */

.maps-room .hs-create-stand-map{
  left:50.1%;
  top:66.0%;
  width:46.6%;
  height:5.7%;

  outline:none !important;
  box-shadow:none !important;
  animation:none !important;
}

/* Tooltip is normally hidden. */
.maps-room .hs-create-stand-map::after{
  opacity:0 !important;
}

/* After Stand Maps and Drive Maps have both been viewed. */
.maps-room.maps-guide-create .hs-create-stand-map{
  display:block !important;
  visibility:visible !important;
  opacity:1 !important;
  pointer-events:auto !important;

  outline:3px solid rgba(255,214,121,.98) !important;
  outline-offset:-3px !important;

  box-shadow:
    inset 0 0 22px rgba(255,218,130,.28),
    0 0 0 2px rgba(177,105,20,.8),
    0 0 31px 11px rgba(226,148,31,.76) !important;

  animation:
    maps-create-stand-guidance 1.5s ease-in-out infinite !important;
}

/* Keep its label visible during the guided state. */
.maps-room.maps-guide-create .hs-create-stand-map::after{
  opacity:1 !important;
}

/* Stronger hover/focus treatment. */
.maps-room.maps-guide-create .hs-create-stand-map:hover,
.maps-room.maps-guide-create .hs-create-stand-map:focus-visible{
  outline:3px solid rgba(255,228,160,1) !important;

  box-shadow:
    inset 0 0 27px rgba(255,225,147,.36),
    0 0 0 3px rgba(192,122,27,.9),
    0 0 38px 14px rgba(236,165,45,.88) !important;
}

@keyframes maps-create-stand-guidance{
  0%,100%{
    filter:brightness(1);
  }

  50%{
    filter:brightness(1.2);
  }
}

/* ================================================================
   Create Stand Map guided experience
   ================================================================ */

.create-stand-map-experience{
  display:grid;
  gap:14px;
}

.create-stand-map-header{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:18px;
}

.create-stand-map-header h2{
  margin:0;
}

.create-stand-instruction{
  margin:5px 0 0;
  color:#65492e;
  font-size:16px;
  line-height:1.45;
}

.create-stand-return{
  flex:0 0 auto;
  width:42px;
  height:42px;
  border:1px solid #b77b27;
  border-radius:50%;
  background:#eee5d7;
  color:#241508;
  font-size:24px;
  font-weight:700;
  cursor:pointer;
}

.create-stand-map-frame{
  position:relative;
  overflow:hidden;
  width:100%;
  min-height:520px;
  border:1px solid #b98a48;
  border-radius:15px;
  background:#d9d8c8;
}

.create-stand-map-frame > img{
  display:block;
  width:100%;
  height:100%;
  min-height:520px;
  object-fit:cover;
}

/* The predetermined location Craig selects. */
.create-stand-star{
  position:absolute;
  left:37.7%;
  top:50.7%;
  z-index:4;

  display:grid;
  place-items:center;

  width:48px;
  height:48px;
  padding:0;

  transform:translate(-50%,-50%);

  border:0;
  border-radius:50%;

  background:rgba(255,248,216,.18);
  color:#080604;

  font-size:37px;
  line-height:1;

  cursor:pointer;

  filter:drop-shadow(0 2px 2px rgba(255,255,255,.95))
         drop-shadow(0 3px 5px rgba(0,0,0,.82));

  animation:create-stand-star-pulse 1.35s ease-in-out infinite;
}

.create-stand-star:hover,
.create-stand-star:focus-visible{
  outline:3px solid #f3bf54;
  outline-offset:4px;
  transform:translate(-50%,-50%) scale(1.12);
}

.create-stand-star.is-saved{
  color:#f4c248;
  background:#39240e;
  border:2px solid #fff1bd;
  animation:none;
}

@keyframes create-stand-star-pulse{
  0%,100%{
    transform:translate(-50%,-50%) scale(1);
  }

  50%{
    transform:translate(-50%,-50%) scale(1.18);
  }
}

.create-stand-map-callout{
  position:absolute;
  left:calc(37.7% + 31px);
  top:calc(50.7% - 54px);
  z-index:3;

  padding:8px 11px;

  border:1px solid #b37b29;
  border-radius:9px;

  background:#201207;
  color:#f5d38b;

  font-size:13px;
  font-weight:800;

  box-shadow:0 6px 18px rgba(0,0,0,.5);
  pointer-events:none;
}

.create-stand-form{
  display:grid;
  gap:14px;
}

.create-stand-form-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:13px;
}

.create-stand-field{
  display:grid;
  gap:6px;
}

.create-stand-field.full{
  grid-column:1 / -1;
}

.create-stand-field label{
  color:#76511e;
  font-size:11px;
  font-weight:800;
  letter-spacing:.09em;
  text-transform:uppercase;
}

.create-stand-field input,
.create-stand-field select,
.create-stand-field textarea{
  width:100%;
  padding:11px 12px;

  border:1px solid #b99b70;
  border-radius:8px;

  background:#fffdf8;
  color:#2e1b0b;

  font:15px/1.35 Arial,sans-serif;
}

.create-stand-field textarea{
  min-height:90px;
  resize:vertical;
}

.create-stand-location{
  padding:12px 14px;
  border:1px solid #ceb68e;
  border-radius:10px;
  background:#fff8e8;
}

.create-stand-location strong{
  display:block;
  margin-bottom:5px;
  color:#5d3a16;
}

.create-stand-actions{
  display:flex;
  justify-content:flex-end;
  flex-wrap:wrap;
  gap:10px;
}

.saved-stand-popover{
  position:absolute;
  left:calc(37.7% + 32px);
  top:calc(50.7% - 135px);
  z-index:8;

  width:min(330px,45vw);
  padding:15px;

  border:1px solid #8f662e;
  border-radius:12px;

  background:#24160d;
  color:#f0ddba;

  box-shadow:0 16px 38px rgba(0,0,0,.68);
}

.saved-stand-popover[hidden]{
  display:none;
}

.saved-stand-popover .eyebrow{
  color:#d6a44c;
}

.saved-stand-popover h3{
  margin:3px 0 8px;
  color:#f3cf83;
  font-size:23px;
}

.saved-stand-popover p{
  margin:6px 0;
  color:#e2d0ae;
  line-height:1.4;
}

.saved-stand-tags{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-top:10px;
}

.saved-stand-tags span{
  padding:5px 8px;
  border-radius:999px;
  background:#4a351e;
  color:#f0d69d;
  font-size:11px;
  font-weight:700;
}

.saved-stand-waypoint{
  margin-top:11px !important;
  color:#b8d177 !important;
  font-family:Consolas,monospace;
  font-size:12px;
}

@media(max-width:760px){
  .create-stand-form-grid{
    grid-template-columns:1fr;
  }

  .create-stand-field.full{
    grid-column:auto;
  }

  .create-stand-map-frame,
  .create-stand-map-frame > img{
    min-height:390px;
  }

  .saved-stand-popover{
    width:min(300px,76vw);
  }
}

/* Final Create Stand Map instruction presentation. */
.create-stand-instruction{
  max-width:760px !important;
}

.create-stand-x-label{
  max-width:310px !important;
  line-height:1.35 !important;
}

/*
 * After Save, the X remains the review and exit control:
 * hover shows the summary; tap closes and returns.
 */
.create-stand-x.is-saved{
  cursor:pointer !important;
}

/* ===== Guided Create Stand flow ===== */
.dc-guide-glow{
  outline:3px solid rgba(255,214,121,.98) !important;
  outline-offset:2px !important;
  box-shadow:
    0 0 0 2px rgba(177,105,20,.78),
    0 0 24px 8px rgba(236,165,45,.58) !important;
  animation: dcGuidePulse 1.2s ease-in-out infinite;
  border-radius:12px;
}

.dc-guide-glow-soft{
  box-shadow:
    0 0 0 2px rgba(177,105,20,.72),
    0 0 18px 6px rgba(236,165,45,.46) !important;
  animation: dcGuidePulse 1.2s ease-in-out infinite;
}

@keyframes dcGuidePulse{
  0%   { box-shadow: 0 0 0 2px rgba(177,105,20,.72), 0 0 14px 4px rgba(236,165,45,.34); }
  50%  { box-shadow: 0 0 0 3px rgba(214,145,40,.88), 0 0 28px 10px rgba(255,196,90,.62); }
  100% { box-shadow: 0 0 0 2px rgba(177,105,20,.72), 0 0 14px 4px rgba(236,165,45,.34); }
}

.dc-guide-note{
  margin:10px 0 0;
  padding:10px 14px;
  border-left:4px solid #b8711c;
  background:rgba(120,68,12,.08);
  color:#5b4226;
  font-weight:600;
  line-height:1.4;
  border-radius:8px;
}

.dc-guide-hidden-mojibake{
  display:none !important;
}
