<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>Camp Boddington Archives Room</title>
  <link rel="stylesheet" href="../rooms/shared/room-shell.css">
  <link rel="stylesheet" href="./archive-room.css">
  <link rel="stylesheet" href="./v7-final-overrides.css?v=20260801-legacy-final">
</head>
<body>
  <main class="room-shell archive-room" aria-label="Camp Boddington Archives Room">
    <section class="room-stage">
      <img class="room-art" src="./archive-room.png" alt="Camp Boddington Archives Room with legacy books, timeline display, historic photographs, records cabinet, artifacts, publications, archive search desk, and guided preservation actions.">

      <!-- Physical archive objects: redundant affordances for View & Discover. -->
      <button class="room-hotspot archive-object hs-object-legacy" type="button" data-archive-action="legacySeries" aria-label="Open Legacy Series" data-tooltip="Open Legacy Series"></button>
      <button class="room-hotspot archive-object hs-object-artifacts" type="button" data-archive-action="historicArtifacts" aria-label="Open Historic Artifacts" data-tooltip="Open Historic Artifacts"></button>

      <!-- DeerCamp Dedication: central reader and archive card 2. -->
      <button
        class="room-hotspot hs-dedication-screen"
        type="button"
        data-archive-action="dadDedication"
        aria-label="Open DeerCamp Dedication to My Father"
        data-tooltip="Open Dedication">
      </button>

      <button
        class="room-hotspot hs-dedication-card"
        type="button"
        data-archive-action="dadDedication"
        aria-label="Open archive card: DeerCamp Dedication to My Father"
        data-tooltip="Open Dedication">
      </button>

      <!-- Archives carousel: completed experiences. -->
      <button
        class="room-hotspot hs-carousel-legacy"
        type="button"
        data-status="available"
        data-archive-action="legacySeries"
        aria-label="Open Legacy Series Dad"
        data-tooltip="Open Legacy Series">
      </button>

      <button
        class="room-hotspot hs-carousel-artifacts"
        type="button"
        data-status="available"
        data-archive-action="historicArtifacts"
        aria-label="Open Eric's Historic Artifacts"
        data-tooltip="Open Historic Artifacts">
      </button>

      <!-- Guided View & Discover pills. -->
      <button class="room-hotspot hs-view-legacy" type="button" data-object="pill" data-status="available" data-archive-action="legacySeries" aria-label="Legacy Series" data-tooltip="Open Legacy Series"></button>
      <button class="room-hotspot hs-view-artifacts" type="button" data-object="pill" data-status="available" data-archive-action="historicArtifacts" aria-label="Historic Artifacts" data-tooltip="Open Historic Artifacts"></button>

      <!-- Guided Create & Preserve pills. -->
      <button class="room-hotspot hs-create-photo" type="button" data-object="pill" data-status="available" data-archive-action="addHistoricPhoto" aria-label="Add Historic Photo" data-tooltip="Record Artifact Memory"></button>
      <button class="room-hotspot hs-upload-artifact" type="button" data-object="pill" data-status="available" data-archive-action="uploadArtifact" aria-label="Upload Artifact" data-tooltip="Share Camp Memory"></button>

      <!-- Shared room navigation. -->
      <button class="room-hotspot hs-back" type="button" data-room-nav="back" aria-label="Back to Camp" data-tooltip="Back to Camp Table"></button>
      <button class="room-hotspot hs-archives" type="button" data-room-nav="archives" aria-current="page" aria-label="Archives Room"></button>
      <button class="room-hotspot hs-maps" type="button" data-room-nav="maps" aria-label="Maps Room" data-tooltip="Maps Room"></button>
      <button class="room-hotspot hs-campfire" type="button" data-room-nav="campfire" aria-label="CampFire Room" data-tooltip="CampFire Room"></button>
      <button class="room-hotspot hs-memory" type="button" data-room-nav="memory" aria-label="Memory and Voice Room" data-tooltip="Memory and Voice Room"></button>
    </section>
  </main>

  <script src="../rooms/shared/content-viewer.js"></script>
  <script src="../rooms/shared/room-toast.js"></script>
  <script src="../rooms/shared/room-navigation.js"></script>
  <script src="../rooms/shared/room-hover-engine.js"></script>
  <script src="./archive-room-config.js"></script>
  <script src="./archive-room.js?v=20260801-legacy-final"></script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll('[data-room-nav="back"]').forEach(button => {
        button.addEventListener("click", () => {
          localStorage.setItem("campBoddington.archiveVisited", "true");
          sessionStorage.setItem("campBoddington.returnToTabletop", "true");
        }, true);
      });
    });
  </script>
  <script id="archives-inline-guidance">
  (function () {
    "use strict";

    const LEGACY = "legacySeries";
    const ARTIFACTS = "historicArtifacts";

    let chosenExperience = null;
    let experienceWasOpen = false;
    let returnHandled = false;

    function legacyShelf() {
      return document.querySelector(".hs-object-legacy");
    }

    function artifactsShelf() {
      return document.querySelector(".hs-object-artifacts");
    }

    function clearGuidance() {
      document.querySelectorAll(".demo-shelf-glow").forEach(function (element) {
        element.classList.remove("demo-shelf-glow");
      });
    }

    function applyGlow(element) {
      if (!element) return;

      element.classList.remove("demo-shelf-glow");
      void element.offsetWidth;
      element.classList.add("demo-shelf-glow");
    }

    function showBothEntryChoices() {
      chosenExperience = null;
      experienceWasOpen = false;
      returnHandled = false;

      clearGuidance();

      const legacy = legacyShelf();
      const artifacts = artifactsShelf();

      if (legacy) {
        legacy.dataset.tooltip =
          "Open Legacy Series OR Open Historic Artifacts";
        applyGlow(legacy);
      }

      if (artifacts) {
        artifacts.dataset.tooltip =
          "Open Historic Artifacts OR Open Legacy Series";
        applyGlow(artifacts);
      }
    }

    function showOppositeChoice() {
      if (!chosenExperience || returnHandled) return;

      returnHandled = true;
      experienceWasOpen = false;
      clearGuidance();

      if (chosenExperience === LEGACY) {
        const artifacts = artifactsShelf();

        if (artifacts) {
          artifacts.dataset.tooltip = "Open Historic Artifacts";
          applyGlow(artifacts);
        }

        return;
      }

      if (chosenExperience === ARTIFACTS) {
        const legacy = legacyShelf();

        if (legacy) {
          legacy.dataset.tooltip = "Open Legacy Series";
          applyGlow(legacy);
        }
      }
    }

    function experienceIsVisible() {
      return Boolean(
        document.querySelector(
          '.legacy-overlay, .room-modal, [role="dialog"][aria-modal="true"]'
        )
      );
    }

    document.addEventListener(
      "click",
      function (event) {
        const action = event.target.closest("[data-archive-action]");

        if (!action) return;

        const key = action.getAttribute("data-archive-action");

        if (key !== LEGACY && key !== ARTIFACTS) return;

        chosenExperience = key;
        experienceWasOpen = true;
        returnHandled = false;
        clearGuidance();
      },
      true
    );

    /*
     * Watch the DOM so this works for:
     * - Return to Archives
     * - the Legacy close X
     * - completion of the Legacy sequence
     * - shared room-modal close controls
     */
    const observer = new MutationObserver(function () {
      if (!chosenExperience || !experienceWasOpen || returnHandled) return;

      window.setTimeout(function () {
        if (!experienceIsVisible()) {
          showOppositeChoice();
        }
      }, 120);
    });

    function start() {
      observer.observe(document.body, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ["class", "hidden", "style"]
      });

      window.setTimeout(showBothEntryChoices, 250);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start, { once: true });
    } else {
      start();
    }

    window.addEventListener("pageshow", function (event) {
      if (event.persisted) {
        window.setTimeout(showBothEntryChoices, 150);
      }
    });

    window.ArchivesDemoGuidance = {
      showBoth: showBothEntryChoices,
      showOpposite: showOppositeChoice
    };
  })();
  </script>
</body>
</html>
