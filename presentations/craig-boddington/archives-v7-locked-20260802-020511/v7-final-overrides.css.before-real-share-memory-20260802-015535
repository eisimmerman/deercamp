.saved-artifact-image b{
  position:absolute;
  top:7px;
  left:7px;
  padding:4px 7px;
  border-radius:4px;
  background:#d59a38;
  color:#1a1106;
  font:800 9px/1 Arial,sans-serif;
  letter-spacing:.12em;
}

.saved-artifact-copy{
  display:grid;
  align-content:center;
  gap:2px;
  padding:8px 11px;
  background:
    linear-gradient(180deg,#21170b,#100a05);
}

.saved-artifact-copy small{
  color:#dca64a;
  font-size:8px;
  font-weight:800;
  letter-spacing:.13em;
}

.saved-artifact-copy strong{
  overflow:hidden;
  color:#f0d49e;
  font:700 15px/1.1 Georgia,serif;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.saved-artifact-copy em,
.saved-artifact-copy span{
  color:#bca77e;
  font:normal 9px/1.2 Arial,sans-serif;
}

@media(max-width:760px){
  .artifact-memory-choice-grid,
  .artifact-recorder,
  .artifact-memory-review{
    grid-template-columns:1fr;
  }

  .artifact-memory-choice{
    grid-template-rows:180px auto auto auto;
  }

  .artifact-memory-choice img,
  .artifact-recorder-object img,
  .artifact-memory-review-image img{
    height:240px;
  }
}

/* ================================================================
   Archives final Create step — Share Camp Memory
   ================================================================ */

.archive-room .hs-upload-artifact.demo-share-glow{
  display:block !important;
  visibility:visible !important;
  opacity:1 !important;
  border:3px solid rgba(255,222,139,.98) !important;
  outline:1px solid rgba(92,53,7,.95) !important;
  outline-offset:-5px !important;
  background:rgba(235,164,45,.06) !important;
  box-shadow:
    inset 0 0 24px rgba(255,220,134,.34),
    0 0 0 2px rgba(187,112,17,.72),
    0 0 32px 11px rgba(230,151,31,.78) !important;
  animation:archives-share-persistent-glow 1.45s ease-in-out infinite !important;
}

.archive-room .hs-upload-artifact.demo-share-glow::after{
  content:"" !important;
  display:block !important;
  position:absolute !important;
  inset:4px !important;
  border:2px solid rgba(255,229,160,.88) !important;
  border-radius:8px !important;
  background:rgba(255,190,59,.07) !important;
  box-shadow:
    inset 0 0 18px rgba(255,219,131,.28),
    0 0 18px rgba(229,150,30,.48) !important;
  animation:none !important;
  pointer-events:none !important;
}

@keyframes archives-share-persistent-glow{
  0%,100%{
    filter:brightness(1.04);
  }

  50%{
    filter:brightness(1.20);
  }
}

.share-memory-kicker{
  margin:0 0 6px;
  color:#dca74c;
  font-size:10px;
  font-weight:800;
  letter-spacing:.15em;
}

.share-memory-start h3,
.share-memory-selected-copy h3,
.share-memory-coming-next h3{
  margin:0 0 12px;
  color:#f0d49e;
  font:700 30px/1.12 Georgia,serif;
}

.share-memory-intro{
  margin:0 0 18px;
  color:#d6c39c;
  line-height:1.5;
}

.share-memory-steps{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
  margin-bottom:20px;
}

.share-memory-steps article{
  display:grid;
  grid-template-columns:34px 1fr;
  gap:10px;
  padding:12px;
  border:1px solid #6f4c1d;
  border-radius:9px;
  background:#151007;
}

.share-memory-steps article>span{
  display:grid;
  place-items:center;
  width:30px;
  height:30px;
  border-radius:50%;
  background:#5e3b12;
  color:#f2cf88;
  font-weight:800;
}

.share-memory-steps strong{
  color:#efd29a;
}

.share-memory-steps p{
  margin:4px 0 0;
  color:#bba77e;
  font-size:12px;
  line-height:1.35;
}

.share-memory-photo-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:16px;
}

.share-memory-photo{
  display:grid;
  gap:5px;
  overflow:hidden;
  padding:0 0 13px;
  border:1px solid #76501e;
  border-radius:10px;
  background:#120d07;
  color:#efd29a;
  text-align:left;
  cursor:pointer;
}

.share-memory-photo img{
  width:100%;
  height:210px;
  object-fit:cover;
}

.share-memory-photo span,
.share-memory-photo strong,
.share-memory-photo small{
  margin-inline:13px;
}

.share-memory-photo span{
  margin-top:8px;
  color:#dca74c;
  font-size:9px;
  font-weight:800;
  letter-spacing:.14em;
}

.share-memory-photo strong{
  font:700 20px/1.15 Georgia,serif;
}

.share-memory-photo small{
  color:#bba77e;
}

.share-memory-photo:hover,
.share-memory-photo:focus-visible{
  border-color:#e0aa50;
  box-shadow:0 0 24px rgba(218,146,35,.38);
}

.share-memory-build-note{
  margin:16px 0 0;
  color:#a99570;
  font-size:12px;
}

.share-memory-selected{
  display:grid;
  grid-template-columns:minmax(280px,.95fr) minmax(320px,1.05fr);
  gap:25px;
}

.share-memory-selected-photo img,
.share-memory-coming-next img{
  display:block;
  width:100%;
  max-height:390px;
  object-fit:contain;
  border:1px solid #76501e;
  border-radius:10px;
  background:#080604;
}

.share-memory-ready{
  display:grid;
  gap:4px;
  margin-top:20px;
  padding:16px;
  border:1px solid #76501e;
  border-radius:9px;
  background:#171006;
  color:#e3c68d;
}

@media(max-width:760px){
  .share-memory-steps,
  .share-memory-photo-grid,
  .share-memory-selected{
    grid-template-columns:1fr;
  }
}
