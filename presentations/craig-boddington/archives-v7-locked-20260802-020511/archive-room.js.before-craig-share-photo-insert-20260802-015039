              disabled>
              Stop Recording
            </button>
          </div>

          <div data-recording-playback hidden>
            <p class="artifact-memory-kicker">
              YOUR RECORDING
            </p>

            <audio controls
              preload="metadata"
              data-recording-audio></audio>

            <div class="artifact-recorder-review-action">
              <button class="room-action-btn primary"
                type="button"
                data-recording-review>
                Review Artifact Memory
              </button>
            </div>
          </div>
        </div>
      </div>`
    });

    setTimeout(()=>{
      const startButton=
        document.querySelector('[data-recording-start]');
      const stopButton=
        document.querySelector('[data-recording-stop]');
      const reviewButton=
        document.querySelector('[data-recording-review]');
      const playback=
        document.querySelector('[data-recording-playback]');
      const audio=
        document.querySelector('[data-recording-audio]');
      const label=
        document.querySelector('[data-recording-label]');
      const time=
        document.querySelector('[data-recording-time]');
      const status=
        document.querySelector('[data-recording-status]');
      const errorBox=
        document.querySelector('[data-recording-error]');

      let recorder=null;
      let stream=null;
      let chunks=[];
      let timer=null;
      let elapsed=0;

      function stopTimer(){
        if(timer){
          window.clearInterval(timer);
          timer=null;
        }
      }

      startButton?.addEventListener('click',async()=>{
        try{
          errorBox.hidden=true;

          stream=await navigator.mediaDevices.getUserMedia({
            audio:true
          });

          chunks=[];

          const options=
            MediaRecorder.isTypeSupported(
              'audio/webm;codecs=opus'
            )
              ? {mimeType:'audio/webm;codecs=opus'}
              : undefined;

          recorder=new MediaRecorder(stream,options);

          recorder.addEventListener('dataavailable',event=>{
            if(event.data && event.data.size){
              chunks.push(event.data);
            }
          });

          recorder.addEventListener('stop',()=>{
            stopTimer();

            stream?.getTracks().forEach(track=>track.stop());

            artifactRecordingBlob=new Blob(chunks,{
              type:recorder.mimeType || 'audio/webm'
            });

            clearArtifactRecordingUrl();

            artifactRecordingUrl=URL.createObjectURL(
              artifactRecordingBlob
            );

            artifactRecordingDuration=Math.max(elapsed,1);

            audio.src=artifactRecordingUrl;
            playback.hidden=false;

            label.textContent='Recording complete';
            time.textContent=formatArtifactDuration(
              artifactRecordingDuration
            );

            status.classList.remove('is-recording');
            status.classList.add('is-complete');
          });

          elapsed=0;
          time.textContent='0:00';
          label.textContent='Recording voice memory';

          status.classList.add('is-recording');
          startButton.disabled=true;
          stopButton.disabled=false;

          recorder.start();

          timer=window.setInterval(()=>{
            elapsed+=1;
            time.textContent=formatArtifactDuration(elapsed);
          },1000);
        }
        catch(error){
          errorBox.hidden=false;
          errorBox.textContent=
            'Microphone access was not available. Please allow ' +
            'microphone permission and try again.';

          startButton.disabled=false;
          stopButton.disabled=true;
        }
      });

      stopButton?.addEventListener('click',()=>{
        if(recorder && recorder.state==='recording'){
          recorder.stop();
        }

        stopButton.disabled=true;
      });

      reviewButton?.addEventListener('click',()=>{
        if(!artifactRecordingBlob) return;

        audio.pause();

        openArtifactMemoryReview(
          name,
          artifactRecordingDuration
        );
      });
    },0);
  }

