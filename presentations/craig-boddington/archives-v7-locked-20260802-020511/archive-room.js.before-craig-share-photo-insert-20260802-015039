  function openArtifactMemoryRecorder(name){
    if(!viewer) return;

    clearArtifactRecordingUrl();
    artifactRecordingBlob=null;
    artifactRecordingDuration=0;

    const image=artifactMemoryImage(name);

    viewer.open({
      heading:'Record Artifact Memory',
      html:`<div class="artifact-recorder">
