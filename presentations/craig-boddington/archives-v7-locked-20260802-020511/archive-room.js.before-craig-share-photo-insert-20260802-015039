  async function saveArtifactMemory(name,duration){
    if(!artifactRecordingBlob) return;

    await saveArtifactAudio(artifactRecordingBlob);

    const savedMemory={
      name,
      duration,
      image:artifactMemoryImage(name),
      savedAt:new Date().toISOString()
    };

    localStorage.setItem(
      'campBoddington.artifactMemory',
      JSON.stringify(savedMemory)
    );

    renderSavedArtifactCard();

    viewer.open({
      heading:'Artifact Memory Saved',
      html:`<div class="artifact-memory-success">
