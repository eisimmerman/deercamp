    try{
      return JSON.parse(
        localStorage.getItem(
          'campBoddington.artifactMemory'
        ) || 'null'
      );
    }
    catch(error){
      return null;
    }
  }

  function renderSavedArtifactCard(){
    const stage=document.querySelector('.room-stage');
    const saved=getSavedArtifactMemory();

    document
      .querySelector('.saved-artifact-carousel-card')
      ?.remove();

    if(!stage || !saved) return;

    const card=document.createElement('button');

    card.type='button';
    card.className='saved-artifact-carousel-card';

    card.innerHTML=`
      <span class="saved-artifact-image">
        <img src="${saved.image}" alt="${saved.name}">
        <b>NEW</b>
      </span>

      <span class="saved-artifact-copy">
        <small>ARTIFACT MEMORY</small>
        <strong>${saved.name}</strong>
        <em>Craig Boddington</em>
        <span>
          Voice Memory -
          ${formatArtifactDuration(saved.duration)}
        </span>
      </span>
    `;

    card.addEventListener('click',openSavedArtifactMemory);
    stage.appendChild(card);
  }

  async function openSavedArtifactMemory(){
    const saved=getSavedArtifactMemory();
    if(!saved || !viewer) return;

    const blob=await loadArtifactAudio();

    if(!blob) return;

    clearArtifactRecordingUrl();
    artifactRecordingUrl=URL.createObjectURL(blob);

    viewer.open({
      heading:'Artifact Memory',
      html:`<div class="artifact-memory-review">
        <div class="artifact-memory-review-image">
          <img src="${saved.image}" alt="${saved.name}">
        </div>

        <div class="artifact-memory-review-copy">
          <p class="artifact-memory-kicker">
            SAVED ARTIFACT MEMORY
          </p>

          <h3>${saved.name}</h3>

          <p class="artifact-memory-byline">
            Craig Boddington
          </p>

          <div class="artifact-memory-audio-preview">
            <div>
              <strong>Voice Memory</strong>
              <span>
                ${formatArtifactDuration(saved.duration)}
              </span>
            </div>

            <audio controls
              preload="metadata"
              src="${artifactRecordingUrl}">
            </audio>
          </div>

          <div class="artifact-memory-transcript-preview">
            <strong>Transcript</strong>
            <p>
              Transcript not generated in this guided demo.
              The original voice recording is preserved.
            </p>
          </div>

          <div class="room-modal-actions">
            <button class="room-action-btn primary"
              type="button"
              data-saved-artifact-close>
              Return to Archives
            </button>
          </div>
        </div>
      </div>`
    });

    setTimeout(()=>{
      document
        .querySelector('[data-saved-artifact-close]')
        ?.addEventListener('click',()=>{
          document
            .querySelector('.artifact-memory-review audio')
            ?.pause();

          viewer.close();
        });
    },0);
  }

  setTimeout(renderSavedArtifactCard,0);

