<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>Camp Boddington Archives Room</title>
  <link rel="stylesheet" href="../shared/room-shell.css">
  <link rel="stylesheet" href="./archive-room.css">
</head>
<body>
  <main class="room-shell archive-room" aria-label="Camp Boddington Archives Room">
    <section class="room-stage">
      <img class="room-art" src="./archive-room.png" alt="Camp Boddington Archives Room with legacy books, timeline display, historic photographs, records cabinet, artifacts, publications, archive search desk, and guided preservation actions.">

      <aside class="room-legend" aria-label="Room capability legend"><h2>ROOM LEGEND</h2><div class="legend-row"><span class="legend-shape square">■</span><span><b>Available Now</b><br>Tap to open</span></div><div class="legend-row"><span class="legend-shape">▲</span><span><b>Emerging</b><br>Preview in progress</span></div><div class="legend-row"><span class="legend-shape circle">●</span><span><b>Future Capability</b><br>Displayed, not tappable</span></div><p class="legend-note">Only active capabilities receive hotspots.</p></aside>

      <!-- Physical archive objects: redundant affordances for View & Discover. -->
      <button class="room-hotspot archive-object hs-object-legacy" type="button" data-archive-action="legacySeries" aria-label="Open Legacy Series" data-tooltip="Open Legacy Series →"></button>
      <button class="room-hotspot archive-object hs-object-artifacts" type="button" data-archive-action="historicArtifacts" aria-label="Open Historic Artifacts" data-tooltip="Open Historic Artifacts →"></button>

      <!-- Guided View & Discover pills. -->
      <button class="room-hotspot hs-view-legacy" type="button" data-object="pill" data-status="available" data-archive-action="legacySeries" aria-label="Legacy Series" data-tooltip="Legacy Series"></button>
      <button class="room-hotspot hs-view-artifacts" type="button" data-object="pill" data-status="available" data-archive-action="historicArtifacts" aria-label="Historic Artifacts" data-tooltip="Historic Artifacts"></button>

      <!-- Guided Create & Preserve pills. -->
      <button class="room-hotspot hs-create-photo" type="button" data-object="pill" data-status="available" data-archive-action="addHistoricPhoto" aria-label="Add Historic Photo" data-tooltip="Add Historic Photo"></button>
      <button class="room-hotspot hs-upload-artifact" type="button" data-object="pill" data-status="available" data-archive-action="uploadArtifact" aria-label="Upload Artifact" data-tooltip="Upload Artifact"></button>

      <!-- Shared room navigation. -->
      <button class="room-hotspot hs-back" type="button" data-room-nav="back" aria-label="Back to Camp" data-tooltip="Back to Camp"></button>
      <button class="room-hotspot hs-archives" type="button" data-room-nav="archives" aria-current="page" aria-label="Archives Room" data-tooltip="Archives Room"></button>
      <button class="room-hotspot hs-maps" type="button" data-room-nav="maps" aria-label="Maps Room" data-tooltip="Maps Room"></button>
      <button class="room-hotspot hs-campfire" type="button" data-room-nav="campfire" aria-label="CampFire Room" data-tooltip="CampFire Room"></button>
      <button class="room-hotspot hs-memory" type="button" data-room-nav="memory" aria-label="Memory and Voice Room" data-tooltip="Memory & Voice Room"></button>
    </section>
  </main>

  <script src="../shared/content-viewer.js"></script>
  <script src="../shared/room-toast.js"></script>
  <script src="../shared/room-navigation.js"></script>
  <script src="../shared/room-hover-engine.js"></script>
  <script src="./archive-room-config.js"></script>
  <script src="./archive-room.js"></script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll('[data-room-nav="back"]').forEach(button => {
        button.addEventListener("click", () => {
          localStorage.setItem("campBoddington.archiveVisited", "true");
          sessionStorage.setItem("campBoddington.returnToTabletop", "true");
        }, true);
      });
    });
  </script>
</body>
</html>
