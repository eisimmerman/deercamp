
/* Legacy chapters: prioritize the photograph over the text panel. */
.legacy-content .legacy-chapter{
  grid-template-columns:1fr !important;
  grid-template-rows:minmax(0,68%) minmax(0,32%) !important;
}

.legacy-content .legacy-chapter figure{
  min-height:0 !important;
  overflow:hidden !important;
}

.legacy-content .legacy-chapter figure img{
  width:100% !important;
  height:100% !important;
  object-fit:contain !important;
}

.legacy-content .legacy-copy{
  min-height:0 !important;
  overflow:auto !important;
  padding:14px 28px 12px !important;
}

.legacy-content .legacy-copy h2{
  margin-bottom:6px !important;
}

.legacy-content .legacy-copy blockquote{
  margin-bottom:8px !important;
}


/* Legacy V7: make photographs visually dominant. */
.legacy-content .legacy-chapter{
  grid-template-rows:minmax(0,76%) minmax(0,24%) !important;
}

.legacy-content .legacy-chapter figure img{
  object-fit:cover !important;
  object-position:center center !important;
}

.legacy-content .legacy-copy{
  padding:10px 26px 8px !important;
}

.legacy-content .legacy-copy h2{
  font-size:clamp(25px,3vw,34px) !important;
  margin:0 0 4px !important;
}

.legacy-content .legacy-copy blockquote{
  font-size:clamp(14px,1.7vw,17px) !important;
  margin:0 0 6px !important;
}

.legacy-content .legacy-copy > p:last-child{
  font-size:13px !important;
  line-height:1.35 !important;
}

/* ================================================================
   LEGACY SERIES — authoritative final layout
   Full photograph above a compact scrollable story panel.
   ================================================================ */

.legacy-content{
  display:block !important;
  height:100% !important;
  min-height:0 !important;
  overflow:hidden !important;
}

.legacy-content .legacy-chapter{
  display:grid !important;
  height:100% !important;
  min-height:0 !important;
  grid-template-columns:1fr !important;
  grid-template-rows:minmax(0,7fr) minmax(0,3fr) !important;
  overflow:hidden !important;
}

.legacy-content .legacy-chapter figure{
  display:grid !important;
  place-items:center !important;
  width:100% !important;
  height:100% !important;
  min-width:0 !important;
  min-height:0 !important;
  margin:0 !important;
  overflow:hidden !important;
  background:#050403 !important;
}

.legacy-content .legacy-chapter figure img{
  display:block !important;
  width:100% !important;
  height:100% !important;
  max-width:100% !important;
  max-height:100% !important;
  object-fit:contain !important;
  object-position:center center !important;
}

.legacy-content .legacy-copy{
  display:block !important;
  height:100% !important;
  min-height:0 !important;
  overflow-y:auto !important;
  padding:10px 28px 8px !important;
}

.legacy-content .legacy-copy h2{
  margin:0 0 4px !important;
  font-size:clamp(24px,3vw,33px) !important;
  line-height:1.05 !important;
}

.legacy-content .legacy-copy blockquote{
  margin:0 0 6px !important;
  font-size:clamp(14px,1.6vw,17px) !important;
  line-height:1.25 !important;
}

.legacy-content .legacy-copy > p:last-child{
  margin:0 !important;
  font-size:13px !important;
  line-height:1.32 !important;
}

/* Closing artwork must appear in full, never cropped. */
.legacy-content .legacy-closing img{
  width:100% !important;
  height:100% !important;
  object-fit:contain !important;
  object-position:center center !important;
  background:#050403 !important;
}
