rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "simmerman.eric@gmail.com";
    }

    function isSteward(campId) {
      return signedIn()
        && exists(/databases/$(database)/documents/campAccess/$(campId))
        && get(/databases/$(database)/documents/campAccess/$(campId)).data.stewardUid == request.auth.uid;
    }

    function hasCampAccess(campId) {
      return isSteward(campId)
        || (
          signedIn()
          && exists(/databases/$(database)/documents/campAccess/$(campId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/campAccess/$(campId)/members/$(request.auth.uid)).data.memberUid == request.auth.uid
        );
    }
    function isCampPublic(campId) {
      return exists(/databases/$(database)/documents/camps/$(campId))
        && (
          get(/databases/$(database)/documents/camps/$(campId)).data.get("isPublic", false) == true
          || get(/databases/$(database)/documents/camps/$(campId)).data.get("publishState", "") == "public"
        );
    }


    match /camps/{campId} {
      allow read: if true;
      allow create, update, delete: if isSteward(campId);
    }

    match /campPrivate/{campId} {
      allow read, create, update, delete: if isSteward(campId);
    }

    match /camps/{campId}/campfeed/{itemId} {
      allow read: if isCampPublic(campId) || hasCampAccess(campId);
      allow create, update, delete: if false;
    }

    match /campAccess/{campId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /camps/{campId}/campStats/{statId} {
      allow read: if hasCampAccess(campId);

      allow create: if hasCampAccess(campId)
        && request.resource.data.campId == campId
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.source == "CampStatsMgr";

      allow update, delete: if false;
    }

    match /campMetricsEvents/{eventId} {
      allow read: if request.auth != null
        && request.auth.token.email == "simmerman.eric@gmail.com";

      allow create, update, delete: if false;
    }

    match /shortLinks/{code} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /shortLinkClicks/{clickId} {
      allow create: if true;
      allow read, update, delete: if false;
    }


    match /campStories/{storyId} {
      allow read, write: if false;
    }

    match /feedItems/{feedId} {
      function validCommentAppend() {
        let existingComments = resource.data.get("comments", []);
        let nextComments = request.resource.data.get("comments", []);
        let newComment = nextComments[nextComments.size() - 1];

        return hasCampAccess(resource.data.campId)
          && resource.data.published == true
          && request.resource.data.campId == resource.data.campId
          && existingComments is list
          && nextComments is list
          && nextComments.size() == existingComments.size() + 1
          && nextComments == existingComments.concat([newComment])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["comments", "commentsUpdatedAtClient"])
          && newComment is map
          && newComment.keys().hasAll([
            "id",
            "author",
            "authorName",
            "uid",
            "text",
            "createdAt",
            "createdAtMs"
          ])
          && newComment.keys().hasOnly([
            "id",
            "author",
            "authorName",
            "uid",
            "text",
            "createdAt",
            "createdAtMs"
          ])
          && newComment.uid == request.auth.uid
          && newComment.id is string
          && newComment.id.size() > 0
          && newComment.id.size() <= 100
          && newComment.author is string
          && newComment.author.size() > 0
          && newComment.author.size() <= 200
          && newComment.authorName == newComment.author
          && newComment.text is string
          && newComment.text.size() > 0
          && newComment.text.size() <= 1000
          && newComment.createdAt is string
          && newComment.createdAt.size() > 0
          && newComment.createdAt.size() <= 64
          && newComment.createdAtMs is int
          && request.resource.data.commentsUpdatedAtClient is string
          && request.resource.data.commentsUpdatedAtClient.size() > 0
          && request.resource.data.commentsUpdatedAtClient.size() <= 64;
      }

      allow read: if resource.data.published == true
        && (
          isCampPublic(resource.data.campId)
          || hasCampAccess(resource.data.campId)
        );

      allow create: if hasCampAccess(request.resource.data.campId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.published == true
        && request.resource.data.source == "app";

      allow update: if (
          isSteward(resource.data.campId)
          && request.resource.data.campId == resource.data.campId
          && request.resource.data.authorId == resource.data.authorId
          && resource.data.published == true
          && request.resource.data.published == false
          && request.resource.data.removedReason == "steward_removed"
        )
        || validCommentAppend();

      allow delete: if false;
    }
  }
}
