rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "simmerman.eric@gmail.com";
    }

    function isSteward(campId) {
      return signedIn()
        && exists(/databases/$(database)/documents/campAccess/$(campId))
        && get(/databases/$(database)/documents/campAccess/$(campId)).data.stewardUid == request.auth.uid;
    }

    function hasCampAccess(campId) {
      return isSteward(campId)
        || (
          signedIn()
          && exists(/databases/$(database)/documents/campAccess/$(campId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/campAccess/$(campId)/members/$(request.auth.uid)).data.memberUid == request.auth.uid
        );
    }

    match /camps/{campId} {
      allow read: if true;
      allow create, update, delete: if isSteward(campId);
    }

    match /camps/{campId}/campfeed/{itemId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /campAccess/{campId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /camps/{campId}/campStats/{statId} {
      allow read: if hasCampAccess(campId);

      allow create: if hasCampAccess(campId)
        && request.resource.data.campId == campId
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.source == "CampStatsMgr";

      allow update, delete: if false;
    }

    match /campMetricsEvents/{eventId} {
      allow read: if request.auth != null
        && request.auth.token.email == "simmerman.eric@gmail.com";

      allow create, update, delete: if false;
    }

    match /shortLinks/{code} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /shortLinkClicks/{clickId} {
      allow create: if true;
      allow read, update, delete: if false;
    }


    match /campStories/{storyId} {
      allow read, write: if false;
    }

    match /feedItems/{feedId} {
      allow read: if resource.data.published == true;

      allow create: if hasCampAccess(request.resource.data.campId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.published == true
        && request.resource.data.source == "app";

      allow update: if isSteward(resource.data.campId)
        && request.resource.data.campId == resource.data.campId
        && request.resource.data.authorId == resource.data.authorId
        && resource.data.published == true
        && request.resource.data.published == false
        && request.resource.data.removedReason == "steward_removed";

      allow delete: if false;
    }
  }
}
