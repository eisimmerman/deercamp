rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "simmerman.eric@gmail.com";
    }

    function isSteward(campId) {
      return signedIn()
        && exists(/databases/$(database)/documents/campAccess/$(campId))
        && get(/databases/$(database)/documents/campAccess/$(campId)).data.stewardUid == request.auth.uid;
    }

    match /camps/{campId} {
      allow read: if true;
      allow create, update, delete: if isSteward(campId);
    }

    match /camps/{campId}/campfeed/{itemId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /campAccess/{campId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /camps/{campId}/campStats/{statId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.campId == campId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.source == "CampStatsMgr";
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    match /campMetricsEvents/{eventId} {
      allow read: if request.auth != null
        && request.auth.token.email == "simmerman.eric@gmail.com";

      allow create, update, delete: if false;
    }

    match /shortLinks/{code} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /shortLinkClicks/{clickId} {
      allow create: if true;
      allow read, update, delete: if false;
    }


    match /campStories/{storyId} {
      allow read, write: if true;
    }

    match /feedItems/{feedId} {
      allow read: if resource.data.published == true;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.published == true;

      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }
  }
}
